package templates

import (
	"github.com/alexeylcp/angry-box/internal/i18n"
)

templ Index() {
	<div class="max-w-4xl flex flex-col gap-6">
		<div>
			<h2 class="text-2xl font-bold mb-1">{ i18n.T(ctx, "Welcome to Angry-BOX") }</h2>
			<p class="mb-6" style="color: var(--mut)">
				{ i18n.T(ctx, "Lightweight SSH orchestrator for sing-box nodes.") }
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			<section class="tn-card tn-card-hover flex flex-col">
				<h3 class="sect-title">{ i18n.T(ctx, "Hosts") }</h3>
				<p class="text-sm flex-1" style="color: var(--mut)">{ i18n.T(ctx, "Manage remote nodes (servers and routers).") }</p>
				<div class="flex justify-end mt-3">
					<button class="btn btn-primary btn-sm" hx-get="/ui/hosts" hx-target="#main-content" hx-push-url="true">{ i18n.T(ctx, "Go to Hosts") }</button>
				</div>
			</section>

			<section class="tn-card tn-card-hover flex flex-col">
				<h3 class="sect-title">{ i18n.T(ctx, "Chains") }</h3>
				<p class="text-sm flex-1" style="color: var(--mut)">{ i18n.T(ctx, "Build and manage multi-hop proxy chains.") }</p>
				<div class="flex justify-end mt-3">
					<button class="btn btn-primary btn-sm" hx-get="/ui/chains" hx-target="#main-content" hx-push-url="true">{ i18n.T(ctx, "Go to Chains") }</button>
				</div>
			</section>

			<section class="tn-card tn-card-hover flex flex-col">
				<h3 class="sect-title">{ i18n.T(ctx, "Status") }</h3>
				<p class="text-sm flex-1" style="color: var(--mut)">{ i18n.T(ctx, "View overall system and node health.") }</p>
				<div class="flex justify-end mt-3">
					<button class="btn btn-primary btn-sm" hx-get="/ui/status" hx-target="#main-content" hx-push-url="true">{ i18n.T(ctx, "View Status") }</button>
				</div>
			</section>
		</div>
	</div>
}
