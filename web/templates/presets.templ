package templates

import (
	"fmt"
	"strings"

	"github.com/alexeylcp/angry-box/internal/chain"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// presets.templ — custom obfuscation preset CRUD UI (replaces the dead
// Profiles page). Built-in presets are read-only; custom presets live in
// PanelSettings.CustomPresets and are merged into the chain registry via
// LoadPresets.
//
// Reveal-on-edit: the per-protocol field sections (.awg-fields /
// .reality-fields / .xhttp-fields) start display:none. The protocol <select>
// onchange toggles them. For an EDIT of an existing preset the matching
// section is shown on load by initPresetFormSections() in app.js (no inline
// <script> here — templ rejects braces in JS blocks).

// presetInt returns an int field from the matching protocol sub-struct of p,
// or 0 when p is nil / the sub-struct is nil / the field is unknown. Used to
// populate the numeric inputs when editing an existing preset.
func presetInt(p *chain.ConnectionPreset, section, field string) int {
	if p == nil {
		return 0
	}
	switch section {
	case "awg":
		if p.AWG == nil {
			return 0
		}
		switch field {
		case "JC":
			return p.AWG.JC
		case "JMIN":
			return p.AWG.JMIN
		case "JMAX":
			return p.AWG.JMAX
		case "S1":
			return p.AWG.S1
		case "S2":
			return p.AWG.S2
		case "S3":
			return p.AWG.S3
		case "S4":
			return p.AWG.S4
		case "ITime":
			return p.AWG.ITime
		case "H1":
			return p.AWG.H1
		case "H2":
			return p.AWG.H2
		case "H3":
			return p.AWG.H3
		case "H4":
			return p.AWG.H4
		case "CPSLevel":
			return p.AWG.CPSLevel
		}
	case "reality":
		if p.Reality == nil {
			return 0
		}
		if field == "ShortIDLen" {
			return p.Reality.ShortIDLen
		}
	}
	return 0
}

templ PresetsPage(builtins []chain.ConnectionPreset, customs []chain.ConnectionPreset) {
	<div class="flex flex-col gap-6">
		<div class="flex items-center justify-between flex-wrap gap-3">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Presets") }</h2>
			<button class="btn btn-primary btn-sm" hx-get="/ui/presets/new" hx-target="#modal-container">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
				{ i18n.T(ctx, "Create custom preset") }
			</button>
		</div>

		<section class="tn-card tn-card-hover">
			<div class="flex items-center justify-between mb-3">
				<h3 class="sect-title">{ i18n.T(ctx, "Custom presets") }</h3>
			</div>
			if len(customs) == 0 {
				<p class="text-sm py-4 text-center" style="color: var(--mut)">{ i18n.T(ctx, "No custom presets.") }</p>
			} else {
				<div class="flex flex-col gap-2">
					for _, c := range customs {
						<div class="flex items-center gap-2 p-2" style="border: 1px solid var(--bd); border-radius: 8px;">
							<div class="flex-1 flex items-center gap-2 flex-wrap">
								<span class="font-mono text-sm font-semibold">{ c.Name }</span>
								<span class="pill" style="color: var(--pu, var(--a))">{ c.Protocol }</span>
								if c.Description != "" {
									<span class="text-xs" style="color: var(--mut)">{ c.Description }</span>
								}
							</div>
							<button class="btn-icon" title={ i18n.T(ctx, "Edit") } aria-label={ i18n.T(ctx, "Edit") } hx-get={ "/ui/presets/" + c.Name + "/edit" } hx-target="#modal-container">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
							</button>
							<button class="btn-icon" style="color: var(--er)" title={ i18n.T(ctx, "Delete") } aria-label={ i18n.T(ctx, "Delete") } hx-delete={ "/ui/presets/" + c.Name } hx-confirm={ i18n.T(ctx, "Delete preset %s?") } hx-target="closest div" hx-swap="outerHTML">
								<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
							</button>
						</div>
					}
				</div>
			}
		</section>

		<section class="tn-card tn-card-hover">
			<div class="flex items-center justify-between mb-3">
				<h3 class="sect-title">{ i18n.T(ctx, "Built-in presets") }</h3>
			</div>
			<div class="overflow-x-auto">
				<table class="tn-table">
					<thead><tr><th>{ i18n.T(ctx, "Name") }</th><th>{ i18n.T(ctx, "Protocol") }</th><th>{ i18n.T(ctx, "Description") }</th></tr></thead>
					<tbody>
						for _, b := range builtins {
							<tr>
								<td class="font-mono font-semibold">{ b.Name }</td>
								<td>
									if b.Protocol == "" {
										<span class="st st-mut">{ i18n.T(ctx, "global") }</span>
									} else {
										<span class="pill" style="color: var(--pu, var(--a))">{ b.Protocol }</span>
									}
								</td>
								<td class="text-xs" style="color: var(--mut)">{ i18n.TPreset(ctx, b.Name, b.Description) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>
}

templ PresetForm(p *chain.ConnectionPreset) {
	<dialog id="preset-modal" class="modal" open>
		<div class="modal-box">
			<h3 class="text-lg font-semibold mb-4">
				if p != nil {
					{ i18n.T(ctx, "Edit preset") }
				} else {
					{ i18n.T(ctx, "Create custom preset") }
				}
			</h3>
			<form class="flex flex-col gap-4"
				if p != nil {
					hx-post={ "/ui/presets/" + p.Name + "/edit" }
				} else {
					hx-post="/ui/presets"
				}
				hx-target="#modal-container"
				hx-swap="innerHTML">
				<div>
					<label class="lbl">{ i18n.T(ctx, "Preset name") }</label>
					<input type="text" name="name" class="inp" required?={ p == nil } if p != nil { value={ p.Name } } />
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Protocol") }</label>
					<select name="protocol" class="sel" onchange="var f=this.closest('form');['.awg-fields','.reality-fields','.xhttp-fields'].forEach(function(c){var e=f.querySelector(c);if(e)e.style.display='none'});var m={awg:'.awg-fields','vless-reality':'.reality-fields',xhttp:'.xhttp-fields'}[this.value];if(m){var e=f.querySelector(m);if(e)e.style.display='block'}">
						<option value="" if p == nil || p.Protocol == "" { selected }>{ i18n.T(ctx, "Select protocol...") }</option>
						<option value="awg" if p != nil && p.Protocol == "awg" { selected }>AWG</option>
						<option value="vless-reality" if p != nil && p.Protocol == "vless-reality" { selected }>VLESS + Reality</option>
						<option value="xhttp" if p != nil && p.Protocol == "xhttp" { selected }>XHTTP</option>
					</select>
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Description") }</label>
					<input type="text" name="description" class="inp" if p != nil { value={ p.Description } } />
				</div>
				@awgFields(p)
				@realityFields(p)
				@xhttpFields(p)
				<div class="flex justify-end gap-2">
					<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Save") }</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop"><button>{ i18n.T(ctx, "Close") }</button></form>
	</dialog>
}

templ awgFields(p *chain.ConnectionPreset) {
	<div class="awg-fields space-y-2" style={ templ.KV("display", "none") }>
		<div class="grid grid-cols-2 gap-3">
			@presetNumRow(p, "awg_jc", "JC", presetInt(p, "awg", "JC"))
			@presetNumRow(p, "awg_jmin", "JMIN", presetInt(p, "awg", "JMIN"))
			@presetNumRow(p, "awg_jmax", "JMAX", presetInt(p, "awg", "JMAX"))
			@presetNumRow(p, "awg_s1", "S1", presetInt(p, "awg", "S1"))
			@presetNumRow(p, "awg_s2", "S2", presetInt(p, "awg", "S2"))
			@presetNumRow(p, "awg_s3", "S3", presetInt(p, "awg", "S3"))
			@presetNumRow(p, "awg_s4", "S4", presetInt(p, "awg", "S4"))
			@presetNumRow(p, "awg_itime", "ITime", presetInt(p, "awg", "ITime"))
			@presetNumRow(p, "awg_h1", "H1", presetInt(p, "awg", "H1"))
			@presetNumRow(p, "awg_h2", "H2", presetInt(p, "awg", "H2"))
			@presetNumRow(p, "awg_h3", "H3", presetInt(p, "awg", "H3"))
			@presetNumRow(p, "awg_h4", "H4", presetInt(p, "awg", "H4"))
			@presetNumRow(p, "awg_cps_level", "CPS Level", presetInt(p, "awg", "CPSLevel"))
			<div>
				<label class="lbl">{ i18n.T(ctx, "Mimicry") }</label>
				<select name="awg_mimicry" class="sel">
					<option value="" if p == nil || p.AWG == nil || p.AWG.Mimicry == "" { selected }></option>
					<option value="quic" if p != nil && p.AWG != nil && p.AWG.Mimicry == "quic" { selected }>quic</option>
					<option value="sip" if p != nil && p.AWG != nil && p.AWG.Mimicry == "sip" { selected }>sip</option>
					<option value="dns" if p != nil && p.AWG != nil && p.AWG.Mimicry == "dns" { selected }>dns</option>
					<option value="none" if p != nil && p.AWG != nil && p.AWG.Mimicry == "none" { selected }>none</option>
				</select>
			</div>
		</div>
	</div>
}

templ realityFields(p *chain.ConnectionPreset) {
	<div class="reality-fields space-y-3" style={ templ.KV("display", "none") }>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Server names (comma or repeated)") }</label>
			<input type="text" name="reality_server_names" class="inp" if p != nil && p.Reality != nil { value={ strings.Join(p.Reality.ServerNames, ", ") } } placeholder="discord.com, www.microsoft.com" />
		</div>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Fingerprints") }</label>
			<input type="text" name="reality_fingerprints" class="inp" if p != nil && p.Reality != nil { value={ strings.Join(p.Reality.Fingerprints, ", ") } } placeholder="chrome, firefox" />
		</div>
		@presetNumRow(p, "reality_short_id_len", i18n.T(ctx, "Short ID len"), presetInt(p, "reality", "ShortIDLen"))
	</div>
}

templ xhttpFields(p *chain.ConnectionPreset) {
	<div class="xhttp-fields space-y-3" style={ templ.KV("display", "none") }>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Methods") }</label>
			<input type="text" name="xhttp_methods" class="inp" if p != nil && p.XHTTP != nil { value={ strings.Join(p.XHTTP.Methods, ", ") } } placeholder="POST" />
		</div>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Paths") }</label>
			<input type="text" name="xhttp_paths" class="inp" if p != nil && p.XHTTP != nil { value={ strings.Join(p.XHTTP.Paths, ", ") } } placeholder="/api/v3/, /graphql" />
		</div>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Hosts") }</label>
			<input type="text" name="xhttp_hosts" class="inp" if p != nil && p.XHTTP != nil { value={ strings.Join(p.XHTTP.Hosts, ", ") } } placeholder="discord.com" />
		</div>
		<div class="grid grid-cols-2 gap-3">
			@presetNumRow(p, "xhttp_idle_timeout", i18n.T(ctx, "Idle timeout"), 0)
			@presetNumRow(p, "xhttp_ping_timeout", i18n.T(ctx, "Ping timeout"), 0)
		</div>
	</div>
}

templ presetNumRow(p *chain.ConnectionPreset, name string, label string, value int) {
	<div>
		<label class="lbl">{ label }</label>
		<input type="number" name={ name } class="inp" value={ fmt.Sprintf("%d", value) } />
	</div>
}
