package templates

// chainlevels.templ — the v2 chain editor: ordered LEVELS of node groups with
// per-level balancing strategies, and an entry level that references
// pre-deployed inbound profiles (never creates inbounds — "inbounds first,
// chains second").
//
// Form wire format (parsed by web/chains.go):
//   level_<i>_nodes[]     — node IDs checked on level i (level 0 = entry)
//   level_<i>_strategy    — fallback|urltest|failover|selector ("" = default)
//   inboundref_<nodeID>   — level-0 only: profile deployed on that node
// Transit levels are appended client-side via GET /ui/chains/level-row?i=N
// (hx-swap beforeend into #chain-levels).

import (
	"fmt"

	"github.com/alexeylcp/angry-box/internal/chain"
	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// ChainProfileOption is one selectable inbound profile for a node.
type ChainProfileOption struct {
	ID       string
	Name     string
	Protocol string
}

// ChainLevelsFormData carries everything the chain form needs.
type ChainLevelsFormData struct {
	Chain         *model.Chain // nil = create
	Hosts         []*model.Host
	NodeProfiles  map[string][]ChainProfileOption // nodeID → profiles deployed there
	Presets       []string                        // obfuscation presets (transit) — names only (legacy)
	PresetGroups  []chain.PresetGroup             // grouped presets (robust/stealth/xhttp/reality) with Jc for the dropdown
	Countries     map[string]string               // nodeID → country code (RU/NL/…)
}

// levelNodeChecked reports whether nodeID sits on level li of the chain.
func levelNodeChecked(c *model.Chain, li int, nodeID string) bool {
	if c == nil || !c.IsLevelized() || li >= len(c.Levels) {
		return false
	}
	for _, n := range c.Levels[li].Nodes {
		if n.ID == nodeID {
			return true
		}
	}
	return false
}

// levelInboundRef returns the chain node's profile reference on level li.
func levelInboundRef(c *model.Chain, li int, nodeID string) string {
	if c == nil || !c.IsLevelized() || li >= len(c.Levels) {
		return ""
	}
	for _, n := range c.Levels[li].Nodes {
		if n.ID == nodeID {
			return n.InboundRef
		}
	}
	return ""
}

// levelStrategy returns the level's strategy ("" for the form default).
func levelStrategyOf(c *model.Chain, li int) string {
	if c == nil || !c.IsLevelized() || li >= len(c.Levels) {
		return ""
	}
	return string(c.Levels[li].Strategy)
}

// levelCount returns the number of levels to render (≥1 for the entry level).
func levelCount(c *model.Chain) int {
	if c == nil || !c.IsLevelized() || len(c.Levels) == 0 {
		return 1
	}
	return len(c.Levels)
}

templ ChainLevelsForm(d ChainLevelsFormData) {
	<dialog id="chain-modal" class="modal" open>
		<div class="modal-box max-w-3xl">
			<h3 class="text-lg font-semibold mb-4">
				if d.Chain != nil {
					{ i18n.T(ctx, "Edit Chain: ") }{ d.Chain.Name }
				} else {
					{ i18n.T(ctx, "Create New Chain") }
				}
			</h3>

			<form
				if d.Chain != nil {
					hx-post={ "/ui/chains/" + d.Chain.Name + "/edit" }
					hx-target={ "#chain-" + d.Chain.Name }
					hx-swap="outerHTML"
				} else {
					hx-post="/ui/chains"
					hx-target="#chains-tbody"
					hx-swap="beforeend"
				}
				hx-on::after-request="if(event.detail.successful && event.detail.elt===this){this.closest('dialog').close()}"
				class="flex flex-col gap-4">

				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label class="lbl">{ i18n.T(ctx, "Chain Name (unique)") }</label>
						<input type="text" name="name" class="inp" required placeholder="my-chain"
							if d.Chain != nil {
								value={ d.Chain.Name }
								disabled
							}
						/>
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "Transport (inter-node)") }</label>
						<select name="transport" class="sel">
							<option value="xhttp" selected?={ d.Chain == nil || d.Chain.Transport == "" || d.Chain.Transport == "xhttp" }>{ i18n.T(ctx, "XHTTP (max obfuscation, recommended)") }</option>
							<option value="reality" selected?={ d.Chain != nil && d.Chain.Transport == "reality" }>{ i18n.T(ctx, "Reality + XHTTP (max obfuscation)") }</option>
							<option value="awg" selected?={ d.Chain != nil && d.Chain.Transport == "awg" }>{ i18n.T(ctx, "AWG / AmneziaWG (single-node levels only)") }</option>
							if d.Chain != nil && d.Chain.Transport == "hysteria2" {
								<option value="hysteria2" selected disabled>{ i18n.T(ctx, "Hysteria2 (paused — QUIC/TLS)") }</option>
							}
						</select>
					</div>
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "Transport preset (inter-node obfuscation)") }</label>
					<select name="profile" class="sel">
						<option value="" selected?={ d.Chain == nil || d.Chain.ObfuscationProfile == "" }>{ i18n.T(ctx, "Use global default (Jc=120, premium)") }</option>
						for _, g := range d.PresetGroups {
							<optgroup label={ g.Label }>
								for _, o := range g.Options {
									if o.Jc > 0 {
										<option value={ o.Name } selected?={ d.Chain != nil && d.Chain.ObfuscationProfile == o.Name }>{ o.Name } (Jc={ fmt.Sprintf("%d", o.Jc) })</option>
									} else {
										<option value={ o.Name } selected?={ d.Chain != nil && d.Chain.ObfuscationProfile == o.Name }>{ o.Name }</option>
									}
								}
							</optgroup>
						}
					</select>
					<p class="hint">{ i18n.T(ctx, "Preset hint") }</p>
				</div>

				<div class="flex flex-col gap-3">
					<div class="flex items-center justify-between">
						<span class="sect-title">{ i18n.T(ctx, "Levels (entry first, exit last)") }</span>
						<button type="button" class="btn btn-outline btn-xs"
							hx-get="/ui/chains/level-row"
							hx-vals="js:{i: document.querySelectorAll('#chain-levels .chain-level').length}"
							hx-target="#chain-levels"
							hx-swap="beforeend"
							hx-disinherit="*">
							{ i18n.T(ctx, "+ Add level") }
						</button>
					</div>
					<div id="chain-levels" class="flex flex-col gap-3">
						for i := 0; i < levelCount(d.Chain); i++ {
							@ChainLevelRow(i, d, i == 0)
						}
					</div>
					<p class="text-xs" style="color: var(--mut)">
						{ i18n.T(ctx, "Traffic flows level by level. A level with several nodes balances across them per its strategy. The entry level references inbounds already deployed on its nodes — create them on the Inbounds page first.") }
					</p>
				</div>

				<div class="flex justify-end gap-2">
					<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="submit" class="btn btn-primary">
						if d.Chain != nil {
							{ i18n.T(ctx, "Save Changes") }
						} else {
							{ i18n.T(ctx, "Create Chain") }
						}
					</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// ChainLevelRow renders one level fieldset. Level 0 (isEntry) adds the
// per-node inbound-profile selects; transit levels get a remove button.
templ ChainLevelRow(index int, d ChainLevelsFormData, isEntry bool) {
	<fieldset class="chain-level p-3 flex flex-col gap-2" data-level-index={ fmt.Sprintf("%d", index) } style="border: 1px solid var(--bd); border-radius: 8px;">
		<div class="flex items-center justify-between">
			<span class="text-sm font-semibold">
				if isEntry {
					{ fmt.Sprintf(i18n.T(ctx, "Level %d — Entry"), index) }
				} else {
					{ fmt.Sprintf(i18n.T(ctx, "Level %d"), index) }
				}
			</span>
			<div class="flex items-center gap-2">
				if !isEntry {
					<label class="text-xs" style="color: var(--mut)">{ i18n.T(ctx, "Strategy") }</label>
					<select name={ fmt.Sprintf("level_%d_strategy", index) } class="sel" style="padding: 0.15rem 0.4rem; font-size: 12px;">
						<option value="" selected?={ levelStrategyOf(d.Chain, index) == "" }>{ i18n.T(ctx, "Round-robin (fallback)") }</option>
						<option value="urltest" selected?={ levelStrategyOf(d.Chain, index) == "urltest" }>urltest</option>
						<option value="failover" selected?={ levelStrategyOf(d.Chain, index) == "failover" }>failover</option>
						<option value="selector" selected?={ levelStrategyOf(d.Chain, index) == "selector" }>selector</option>
					</select>
					<button type="button" class="btn-icon" style="color: var(--er)" title={ i18n.T(ctx, "Delete") } aria-label={ i18n.T(ctx, "Delete") }
						onclick="var f=this.closest('fieldset');f.parentNode.removeChild(f)">✕</button>
				} else {
					<input type="hidden" name={ fmt.Sprintf("level_%d_strategy", index) } value=""/>
				}
			</div>
		</div>
		<div class="grid grid-cols-1 md:grid-cols-2 gap-2">
			for _, h := range d.Hosts {
				<div class="rounded p-2" style="border: 1px solid color-mix(in oklab, var(--bd) 60%, transparent)">
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name={ fmt.Sprintf("level_%d_nodes", index) } value={ h.ID } class="cb"
							checked?={ levelNodeChecked(d.Chain, index, h.ID) }
							if isEntry {
								onchange="var w=this.closest('div').querySelector('.inboundref-wrap');if(w){w.style.display=this.checked?'block':'none'}"
							}
						/>
						if d.Countries[h.ID] != "" {
							<span class="pill">{ d.Countries[h.ID] }</span>
						}
						<span class="font-mono text-sm">{ h.ID }</span>
						<span class="text-xs" style="color: var(--mut2)">({ h.Addr })</span>
					</label>
					if isEntry {
						<div class="inboundref-wrap mt-1" style={ templ.KV("display:none", !levelNodeChecked(d.Chain, index, h.ID)) }>
							if len(d.NodeProfiles[h.ID]) > 0 {
								<select name={ "inboundref_" + h.ID } class="sel w-full" style="padding: 0.15rem 0.4rem; font-size: 12px;">
									<option value="">{ i18n.T(ctx, "— choose inbound —") }</option>
									for _, p := range d.NodeProfiles[h.ID] {
										<option value={ p.ID } selected?={ levelInboundRef(d.Chain, index, h.ID) == p.ID }>
											{ p.Name } ({ p.Protocol })
										</option>
									}
								</select>
							} else {
								<div class="text-xs" style="color: var(--wa)">
									{ i18n.T(ctx, "No inbound deployed on this node.") }
									<a class="link link-primary" hx-get="/ui/inbounds" hx-target="#main-content" hx-push-url="true">{ i18n.T(ctx, "Create / deploy one") }</a>
								</div>
							}
						</div>
					}
				</div>
			}
		</div>
	</fieldset>
}
