package templates

import (
	"strconv"

	"github.com/alexeylcp/angry-box/internal/chain"
	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// services.templ — Service catalog + form. A Service is an operator-defined
// product tier (Marzneshin `Service` analogue) bundled in PanelSettings.Services
// and offered as a single pick in the user wizard ("Step 2 — What"). It
// expands into User.ChainNames/Protocols/ChainExit/MTProxy at save time.
//
// RoutingPresetIDs are STORED but NOT RENDERED into the sing-box config this
// slice (P0b-3) — the form labels this clearly so the operator is not misled.

templ ServicesPage(services []model.Service) {
	<div class="space-y-4">
		<div class="flex items-center justify-between">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Services") }</h2>
			<button class="btn btn-primary btn-sm" hx-get="/ui/services/new" hx-target="#modal-container">{ i18n.T(ctx, "Create service") }</button>
		</div>
		<div class="card bg-base-100/50 border border-base-content/5">
			<div class="card-body">
				<h3 class="font-semibold">{ i18n.T(ctx, "Services") }</h3>
				if len(services) == 0 {
					<span class="text-sm text-base-content/50">{ i18n.T(ctx, "No services defined. Create one in Services, or use the Custom path.") }</span>
				}
				for _, svc := range services {
					<div class="flex items-center gap-2 border border-base-300 rounded-lg p-2">
						<div class="flex-1">
							<span class="font-mono text-sm">{ svc.Name }</span>
							<span class="badge badge-xs ml-2">{ svc.ID }</span>
							if svc.Description != "" {
								<span class="text-xs text-base-content/50 ml-2">{ svc.Description }</span>
							}
							if len(svc.ChainNames) > 0 {
								<div class="text-xs text-base-content/50 mt-1">
									{ i18n.T(ctx, "Chains") }: { chainList(svc.ChainNames) }
								</div>
							}
						</div>
						<button class="btn btn-ghost btn-xs" hx-get={ "/ui/services/" + svc.ID + "/edit" } hx-target="#modal-container">{ i18n.T(ctx, "Edit") }</button>
						<button class="btn btn-ghost btn-xs text-error" hx-delete={ "/ui/services/" + svc.ID } hx-confirm={ i18n.T(ctx, "Delete") + " " + svc.Name + "?" } hx-target="closest div" hx-swap="outerHTML">{ i18n.T(ctx, "Delete") }</button>
					</div>
				}
			</div>
		</div>
		<div id="modal-container"></div>
	</div>
}

// chainList joins chain names with ", " for display.
func chainList(names []string) string {
	out := ""
	for i, n := range names {
		if i > 0 {
			out += ", "
		}
		out += n
	}
	return out
}

templ ServiceForm(svc *model.Service, chains []*model.Chain) {
	<dialog id="service-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="font-bold text-lg mb-4">
				if svc != nil {
					{ i18n.T(ctx, "Edit service") }
				} else {
					{ i18n.T(ctx, "Create service") }
				}
			</h3>
			<form class="space-y-4"
				if svc != nil {
					hx-post={ "/ui/services/" + svc.ID + "/edit" }
				} else {
					hx-post="/ui/services"
				}
				hx-target="#modal-container"
				hx-swap="innerHTML">
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Service ID") }</span></label>
					<input type="text" name="id" class="input input-bordered" required?={ svc == nil } if svc != nil { value={ svc.ID } } />
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Service name") }</span></label>
					<input type="text" name="name" class="input input-bordered" required if svc != nil { value={ svc.Name } } />
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Service description") }</span></label>
					<input type="text" name="description" class="input input-bordered" if svc != nil { value={ svc.Description } } />
				</div>

				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Assigned Chains") }</span></label>
					<div class="space-y-1 max-h-48 overflow-y-auto">
						for _, c := range chains {
							<label class="flex items-center gap-2">
								<input type="checkbox" name="chains" value={ c.Name } class="checkbox checkbox-sm"
									if svc != nil && serviceHasChain(svc, c.Name) { checked } />
								<span class="font-mono text-sm">{ c.Name }</span>
							</label>
						}
					</div>
				</div>

				// Per-chain exit pin: one select per chain, populated from the
				// chain's nodes. The first time a chain is checked the operator
				// can pin the Service's users to a specific exit. Empty = chain
				// default exit (last node). This is the first UI surface for
				// User.ChainExit (model.panel.go), which is already wired in
				// buildMergedRoute.
				if len(chains) > 0 {
					<div class="form-control">
						<label class="label"><span class="label-text">{ i18n.T(ctx, "Default exit") }</span></label>
						<div class="space-y-1">
							for _, c := range chains {
								<div class="flex items-center gap-2">
									<span class="font-mono text-xs w-32 truncate">{ c.Name }</span>
									<select name={ "exit_" + c.Name } class="select select-bordered select-xs">
										<option value="">{ i18n.T(ctx, "Exit node") } (default)</option>
										for _, n := range c.Nodes {
											<option value={ n.ID } if svc != nil && serviceExitForChain(svc, c.Name) == n.ID { selected }>{ n.ID }</option>
										}
									</select>
								</div>
							}
						</div>
					</div>
				}

				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Protocols") }</span></label>
					<div class="flex flex-wrap gap-2">
						for _, proto := range []string{"awg", "vless-reality", "xhttp", "mtproxy"} {
							<label class="flex items-center gap-1">
								<input type="checkbox" name="protocols" value={ proto } class="checkbox checkbox-sm"
									if svc != nil && serviceHasProtocol(svc, proto) { checked } />
								<span class="text-sm">{ proto }</span>
							</label>
						}
					</div>
				</div>

				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Routing presets") }</span></label>
					<span class="text-xs text-base-content/50 mb-1">{ i18n.T(ctx, "destination routing (applies on next deploy — P0b-3)") }</span>
					<div class="space-y-1 max-h-40 overflow-y-auto border border-base-300 rounded-lg p-2">
						for _, cat := range chain.RoutingPresetCategories {
							<div class="text-xs font-semibold text-base-content/60 mt-1">{ cat }</div>
							for _, rp := range chain.GetRoutingPresets(cat) {
								<label class="flex items-center gap-1">
									<input type="checkbox" name="routing_preset_ids" value={ rp.ID } class="checkbox checkbox-xs"
										if svc != nil && serviceHasRoutingPreset(svc, rp.ID) { checked } />
									<span class="text-xs">{ rp.Name }</span>
								</label>
							}
						}
					</div>
				</div>

				// MTProxy block (collapse-arrow, mirrors users.templ pattern).
				<div class="collapse collapse-arrow bg-base-200/50">
					<input type="checkbox" if svc != nil && svc.MTProxy.Enabled { checked } />
					<div class="collapse-title font-medium">MTProxy</div>
					<div class="collapse-content space-y-2">
						<label class="flex items-center gap-2">
							<input type="checkbox" name="mtproxy_enabled" class="checkbox checkbox-sm"
								if svc != nil && svc.MTProxy.Enabled { checked } />
							<span class="text-sm">{ i18n.T(ctx, "Active") }</span>
						</label>
						<div class="form-control">
							<label class="label"><span class="label-text">{ i18n.T(ctx, "FakeTLS Domain") }</span></label>
							<input type="text" name="mtproxy_domain" class="input input-bordered input-sm" placeholder="disk.yandex.ru"
								if svc != nil && svc.MTProxy.Domain != "" { value={ svc.MTProxy.Domain } } />
						</div>
						<div class="form-control">
							<label class="label"><span class="label-text">{ i18n.T(ctx, "Order Index") }</span></label>
							<input type="number" name="mtproxy_order_index" class="input input-bordered input-sm"
								if svc != nil { value={ strconv.Itoa(svc.MTProxy.OrderIndex) } } />
						</div>
					</div>
				</div>

				<div class="modal-action">
					<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Save") }</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop"><button>{ i18n.T(ctx, "Close") }</button></form>
	</dialog>
}

func serviceHasChain(svc *model.Service, name string) bool {
	for _, c := range svc.ChainNames {
		if c == name {
			return true
		}
	}
	return false
}

func serviceHasProtocol(svc *model.Service, proto string) bool {
	for _, p := range svc.Protocols {
		if p == proto {
			return true
		}
	}
	return false
}

func serviceHasRoutingPreset(svc *model.Service, id string) bool {
	for _, r := range svc.RoutingPresetIDs {
		if r == id {
			return true
		}
	}
	return false
}

func serviceExitForChain(svc *model.Service, chainName string) string {
	if svc == nil || svc.DefaultExitByChain == nil {
		return ""
	}
	return svc.DefaultExitByChain[chainName]
}