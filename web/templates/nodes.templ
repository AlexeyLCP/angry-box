package templates

import (
	"context"
	"fmt"

	"github.com/alexeylcp/angry-box/internal/chain"
	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// ─── Nodes List ─────────────────────────────────────────────────────────────────

templ Nodes(hosts []*model.Host, infos []*model.NodeInfo, metrics []*model.NodeMetrics, activeChains map[string]string) {
	<div class="flex flex-col gap-6">
		<div class="flex items-center justify-between flex-wrap gap-3">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Nodes") }</h2>
			<button
				class="btn btn-primary btn-sm"
				onclick="addNodeOpenCapture()">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
				{ i18n.T(ctx, "Add Node") }
			</button>
		</div>

		<section class="tn-card tn-card-hover">
			<div class="overflow-x-auto">
				<table class="tn-table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "ID") }</th>
							<th>{ i18n.T(ctx, "Address") }</th>
							<th>{ i18n.T(ctx, "Country") }</th>
							<th>{ i18n.T(ctx, "Bandwidth") }</th>
							<th>{ i18n.T(ctx, "Deploy Role") }</th>
							<th>{ i18n.T(ctx, "Health") }</th>
							<th class="text-right">{ i18n.T(ctx, "Actions") }</th>
						</tr>
					</thead>
					<tbody id="nodes-tbody">
						for _, h := range hosts {
							@NodeRow(h, findInfo(h.ID, infos), findMetric(h.ID, metrics), activeChains[h.ID])
						}
						if len(hosts) == 0 {
							<tr>
								<td colspan="7" class="text-center py-12" style="color: var(--mut)">
									<div class="flex flex-col items-center gap-3">
										<svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 opacity-20" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
										<p>{ i18n.T(ctx, "No nodes yet. Add your first remote node.") }</p>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>

	<div id="modal-container"></div>
}

// ─── Node Row ───────────────────────────────────────────────────────────────────

templ NodeRow(h *model.Host, info *model.NodeInfo, m *model.NodeMetrics, chainName string) {
	<tr id={"node-" + h.ID}>
		<td>
			<span class="font-semibold">{ h.ID }</span>
			if info != nil && standaloneInboundCount(info) > 0 {
				<div class="text-[11px]" style="color: var(--mut2)">{ fmt.Sprintf("%d %s", standaloneInboundCount(info), i18n.T(ctx, "inbounds")) }</div>
			} else if chainName != "" {
				<div class="text-[11px]" style="color: var(--mut2)">{ chainName }</div>
			}
		</td>
		<td class="font-mono" style="color: var(--mut)">{ h.Addr }</td>
		<td>
			if info != nil && info.Country != "" {
				<span class="pill">{ info.Country }</span>
			} else {
				<span class="pill" style="color: var(--mut2)">—</span>
			}
		</td>
		<td>
			if info != nil && info.Bandwidth != "" {
				<span class="pill">{ info.Bandwidth }</span>
			} else {
				<span class="pill" style="color: var(--mut2)">—</span>
			}
		</td>
		<td>
			if chainName != "" {
				<div class="tooltip" data-tip={i18n.T(ctx, "Managed by chain: ") + chainName}>
					<span class="st st-pu cursor-help">{ i18n.T(ctx, "In Chain") }</span>
				</div>
			} else {
				<div class="tooltip" data-tip={i18n.T(ctx, "Can be deployed as a standalone server")}>
					<span class="st st-mut cursor-help">{ i18n.T(ctx, "Standalone") }</span>
				</div>
			}
		</td>
		<td>
			@NodeStatusCell(h.ID, m)
		</td>
		<td class="text-right whitespace-nowrap">
			<div class="inline-flex gap-1 items-center">
				<button
					class={ "btn btn-xs", templ.KV("btn-primary", chainName == ""), templ.KV("btn-secondary", chainName != "") }
					hx-post={"/ui/nodes/" + h.ID + "/apply"}
					hx-target="#modal-container"
					hx-swap="innerHTML"
					if chainName != "" {
						title={ i18n.T(ctx, "Apply via Chain") + " '" + chainName + "' (" + i18n.T(ctx, "includes standalone inbounds") + ")" }
					} else {
						title={i18n.T(ctx, "Deploy Standalone Config")}
					}>
					{ i18n.T(ctx, "Apply") }
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Capture") }
					aria-label={ i18n.T(ctx, "Capture") }
					hx-get={"/ui/nodes/" + h.ID + "/capture"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Takeover") }
					aria-label={ i18n.T(ctx, "Takeover") }
					hx-get={"/ui/nodes/" + h.ID + "/detect-vpn"}
					hx-target="#main-content"
					hx-swap="outerHTML"
					hx-push-url="true">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" /></svg>
				</button>
				<a class="btn-icon" href={ "/ui/backup/nodes/" + h.ID } download title={ i18n.T(ctx, "Export node") } aria-label={ i18n.T(ctx, "Export node") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
				</a>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Relocate") }
					aria-label={ i18n.T(ctx, "Relocate") }
					hx-get={ "/ui/nodes/" + h.ID + "/relocate" }
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Clone") }
					aria-label={ i18n.T(ctx, "Clone") }
					hx-get={ "/ui/nodes/" + h.ID + "/clone" }
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Diagnose") }
					aria-label={ i18n.T(ctx, "Diagnose") }
					hx-get={ "/ui/nodes/" + h.ID + "/awg-diagnostics" }
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Routing") }
					aria-label={ i18n.T(ctx, "Routing") }
					hx-get={ "/ui/nodes/" + h.ID + "/routing" }
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Edit") }
					aria-label={ i18n.T(ctx, "Edit") }
					hx-get={"/ui/nodes/" + h.ID + "/edit"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
				</button>
				<button
					class="btn-icon"
					style="color: var(--er)"
					title={ i18n.T(ctx, "Delete") }
					aria-label={ i18n.T(ctx, "Delete") }
					hx-delete={"/ui/nodes/" + h.ID}
					hx-confirm={i18n.T(ctx, "Delete node ") + h.ID + "?"}
					hx-target="closest tr"
					hx-swap="outerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
				</button>
			</div>
		</td>
	</tr>
}

// ─── Node Form (edit only) ─────────────────────────────────────────────────────

templ NodeForm(h *model.Host, settings *model.PanelSettings, allKeys []model.SSHKeyEntry, nodeInfo ...*model.NodeInfo) {
	<dialog id="node-modal" class="modal" open>
		<div class="modal-box">
			<h3 class="text-lg font-semibold mb-4">
				if h != nil {
					{ i18n.T(ctx, "Edit Host: ") }{ h.ID }
				} else {
					{ i18n.T(ctx, "Add New Host") }
				}
			</h3>

			if h != nil {
				<form
					hx-post={"/ui/nodes/" + h.ID + "/edit"}
					hx-target={"#node-" + h.ID}
					hx-swap="outerHTML"
					hx-on::after-request="this.closest('dialog').close()"
					class="flex flex-col gap-4">
					<div>
						<label class="lbl">{ i18n.T(ctx, "ID") }</label>
						<input type="text" name="id" class="inp font-mono" value={ h.ID } readonly />
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "SSH Address") } · { i18n.T(ctx, "IP:port") }</label>
						<input type="text" name="addr" class="inp font-mono" value={ h.Addr } readonly />
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "SSH User") }</label>
						<input type="text" name="user" class="inp font-mono" value={ h.User } readonly />
						<a class="btn btn-ghost btn-sm mt-1" href={ "/ui/nodes/" + h.ID + "/capture" }>{ i18n.T(ctx, "Re-capture node") }</a>
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "SSH Key") }</label>
						@sshKeySelect("ssh_key_id", h.KeyPath, settings, allKeys)
						if h.KeyPath == "" && (settings == nil || settings.DefaultSSHKeyID == "") {
							<p class="hint">
								{ i18n.T(ctx, "No SSH key configured and no default key set") } — { i18n.T(ctx, "Import from ~/.ssh/") }
							</p>
						}
					</div>
					@nodeFormFields(nodeInfo...)
					<div class="flex justify-end gap-2">
						<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Save") }</button>
					</div>
				</form>
				if len(nodeInfo) > 0 && nodeInfo[0] != nil {
					@awgOutboundSection(h.ID, nodeInfo[0])
				}
			}
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// sshKeySelect renders the unified SSH-key dropdown. The first option is the
// panel default (when set) or a "Select key..." placeholder. Stored/auto/manual
// keys are grouped under "Stored keys", system keys under "System keys". The
// trailing "manual" option reveals a sibling .manual-key-ta textarea (wired by
// the inline onchange). data-fingerprint on each option drives the capture
// wizard's auto-install preview line.
templ sshKeySelect(name string, selected string, settings *model.PanelSettings, allKeys []model.SSHKeyEntry) {
	<select name={ name } class="sel"
		onchange="var ta=this.parentElement.querySelector('.manual-key-ta');var manual=this.value==='manual';if(ta){ta.style.display=manual?'block':'none';if(!manual)ta.value='';}var prev=this.parentElement.querySelector('.auto-install-preview');if(prev){var fp=this.selectedOptions[0]&&this.selectedOptions[0].dataset.fingerprint;var addr=this.closest('form')&&this.closest('form').querySelector('[name=addr]');var a=addr?addr.value:'';if(fp&&a){prev.textContent=abt('Public key will be added to authorized_keys on')+' '+a+' · '+fp;prev.classList.remove('hidden');}else if(this.value==='manual'&&a){prev.textContent=abt('a new key will be generated and added')+' ('+a+')';prev.classList.remove('hidden');}else{prev.textContent='';prev.classList.add('hidden');}}">
		if settings != nil && settings.DefaultSSHKeyID != "" {
			<option value="">{ i18n.T(ctx, "Default") } ({ defaultKeyName(settings, allKeys) })</option>
		} else {
			<option value="">{ i18n.T(ctx, "Select key...") }</option>
		}
		<optgroup label={ i18n.T(ctx, "Stored keys") }>
			for _, k := range allKeys {
				if k.Source == model.SourceStored || k.Source == model.SourceAuto || k.Source == model.SourceManual {
					<option value={ k.ID } data-fingerprint={ k.Fingerprint } selected?={ k.ID == selected }>
						{ "[" + keyBadge(ctx, k.Source) + "] " + k.Name + keyFpSuffix(k.Fingerprint) }
					</option>
				}
			}
		</optgroup>
		<optgroup label={ i18n.T(ctx, "System keys") }>
			for _, k := range allKeys {
				if k.Source == model.SourceSystem {
					<option value={ k.ID } data-fingerprint={ k.Fingerprint } selected?={ k.ID == selected }>
						{ "🔑 [" + keyBadge(ctx, k.Source) + "] " + k.Name + keyFpSuffix(k.Fingerprint) }
					</option>
				}
			}
		</optgroup>
		<option value="manual">== { i18n.T(ctx, "Paste key manually") } ==</option>
	</select>
}

// nodeFormFields renders country, bandwidth, source fields (shared between create/edit)
templ nodeFormFields(nodeInfo ...*model.NodeInfo) {
	<div class="grid grid-cols-3 gap-3">
		<div>
			<label class="lbl">{ i18n.T(ctx, "Country") }</label>
			<input type="text" name="country" class="inp" value={ niCountry(nodeInfo) } placeholder="FI" />
		</div>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Bandwidth") }</label>
			<input type="text" name="bandwidth" class="inp" value={ niBandwidth(nodeInfo) } placeholder="1 Gbps" />
		</div>
		<div>
			<label class="lbl">{ i18n.T(ctx, "Source") }</label>
			<select name="source" class="sel">
				<option value="ssh_key" if niSource(nodeInfo) == "" || niSource(nodeInfo) == "ssh_key" { selected }>{ i18n.T(ctx, "SSH Key") }</option>
				<option value="password" if niSource(nodeInfo) == "password" { selected }>{ i18n.T(ctx, "Password") }</option>
				<option value="captured" if niSource(nodeInfo) == "captured" { selected }>{ i18n.T(ctx, "Captured") }</option>
			</select>
		</div>
	</div>
	<div class="grid grid-cols-2 gap-3 mt-3">
		<label class="flex items-center gap-2 cursor-pointer">
			<input type="checkbox" name="spare" class="cb" if niSpare(nodeInfo) { checked } />
			<span class="text-sm">{ i18n.T(ctx, "Spare (warm pool)") }</span>
		</label>
		<label class="flex items-center gap-2 cursor-pointer">
			<input type="checkbox" name="auto_relocate" class="cb" if niAutoRelocate(nodeInfo) { checked } />
			<span class="text-sm">{ i18n.T(ctx, "Auto-relocate on down") }</span>
		</label>
	</div>
}

templ awgOutboundSection(nodeID string, info *model.NodeInfo) {
	<div class="divider-x my-3"></div>
	<div class="sect-title mb-2">{ i18n.T(ctx, "AWG outbound") }</div>
	<p class="hint mb-2">{ i18n.T(ctx, "AWG outbound hint") }</p>
	if info != nil {
		for _, ob := range info.AWGOutbounds {
			<div class="flex items-center justify-between text-sm mb-1" style="border: 1px solid var(--bd); border-radius: 8px; padding: 0.4rem 0.6rem;">
				<span class="font-mono">{ ob.IfaceName() }</span>
				<span class="text-xs" style="color: var(--mut)">{ ob.Endpoint }</span>
				<button type="button" class="btn btn-xs btn-ghost"
					hx-post={ "/ui/nodes/" + nodeID + "/awg-outbounds/" + ob.ID + "/delete" }
					hx-target="#modal-container"
					hx-swap="innerHTML">{ i18n.T(ctx, "Delete") }</button>
			</div>
		}
	}
	<form hx-post={ "/ui/nodes/" + nodeID + "/awg-outbounds" } hx-target="#modal-container" hx-swap="innerHTML" class="flex flex-col gap-2">
		<textarea name="conf" class="ta font-mono text-xs" rows="6" placeholder={"[Interface]\n...\n[Peer]\n...\nvpn://"}></textarea>
		<button type="submit" class="btn btn-sm btn-outline">{ i18n.T(ctx, "Add AWG outbound") }</button>
	</form>
}

templ NodeCaptureForm(host *model.Host, settings *model.PanelSettings, allKeys []model.SSHKeyEntry) {
	<dialog id="capture-modal" class="modal" open>
		<div class="modal-box">
			<h3 class="text-lg font-semibold mb-1">{ i18n.T(ctx, "Capture Node: ") }{ host.ID }</h3>
			<div class="text-xs mb-4" style="color: var(--mut)">{ i18n.T(ctx, "Connect via SSH and bring node under management.") }</div>

			<form
				hx-post={"/ui/nodes/" + host.ID + "/capture"}
				hx-target="#capture-result"
				hx-swap="innerHTML"
				class="flex flex-col gap-4">

				<div>
					<label class="lbl">{ i18n.T(ctx, "SSH Address") } · { i18n.T(ctx, "IP:port") }</label>
					<input type="text" name="addr" class="inp font-mono" value={ host.Addr } placeholder="1.2.3.4:22" required />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "Login User") }</label>
					<input type="text" name="login_user" class="inp font-mono" value={ captureUser(host.User) } placeholder="root" />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "SSH Key") }</label>
					@sshKeySelect("ssh_key_id", host.KeyPath, settings, allKeys)
					<textarea name="ssh_key_manual" class="manual-key-ta ta font-mono text-xs mt-2"
						rows="3" style="display:none"
						placeholder="-----BEGIN OPENSSH PRIVATE KEY-----
...
-----END OPENSSH PRIVATE KEY-----"></textarea>
					<div class="auto-install-preview text-xs hidden" style="color: var(--mut)"></div>
				</div>

				<div class="text-sm text-center" style="color: var(--mut)">{ i18n.T(ctx, "— or use login + password —") }</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "Password") }</label>
					<input type="password" name="login_pass" class="inp" placeholder={ i18n.T(ctx, "Enter SSH password") } />
				</div>

				<div>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="auto_install_key" class="cb" checked />
						<span class="text-sm">{ i18n.T(ctx, "Install public key for passwordless access") }</span>
					</label>
					<p class="hint">{ i18n.T(ctx, "If checked, the SSH key selected above will be installed on the target server for future passwordless access.") }</p>
				</div>

				<div class="grid grid-cols-2 gap-3">
					<div>
						<label class="lbl">{ i18n.T(ctx, "Country") }</label>
						<input type="text" name="country" class="inp" placeholder="FI" />
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "Bandwidth") }</label>
						<input type="text" name="bandwidth" class="inp" placeholder="1 Gbps" />
					</div>
				</div>

				<div class="awg3-panel flex flex-col gap-1 p-3">
					<span class="sect-title mb-1">{ i18n.T(ctx, "After connect") }</span>
					<label class="flex items-center gap-2 cursor-pointer py-0.5">
						<input type="checkbox" name="opt_deploy_singbox" class="cb" checked />
						<span class="text-sm">{ i18n.T(ctx, "Deploy sing-box-extended (binary)") }</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer py-0.5">
						<input type="checkbox" name="opt_install_awg" class="cb" />
						<span class="text-sm">{ i18n.T(ctx, "Install AmneziaWG kernel module") }</span>
					</label>
					<label class="flex items-center gap-2 cursor-pointer py-0.5">
						<input type="checkbox" name="opt_takeover" class="cb" />
						<span class="text-sm">{ i18n.T(ctx, "Detect existing VPN (takeover wizard)") }</span>
					</label>
				</div>

				<div class="flex justify-end gap-2">
					<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="button" class="btn btn-outline btn-sm"
						hx-post={ "/ui/nodes/" + host.ID + "/test" }
						hx-target="#capture-test-result"
						hx-include="closest form">
						{ i18n.T(ctx, "Test connection") }
					</button>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Verify & connect") }</button>
				</div>
			</form>

			<div id="capture-test-result" class="mt-2"></div>
			<div id="capture-result" class="mt-2"></div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// captureUser returns the user to pre-fill in the capture wizard: the host's
// stored user if any, otherwise "root".
func captureUser(u string) string {
	if u == "" {
		return "root"
	}
	return u
}

// ─── Helpers ────────────────────────────────────────────────────────────────────

func findInfo(id string, infos []*model.NodeInfo) *model.NodeInfo {
	for _, ni := range infos {
		if ni != nil && ni.ID == id {
			return ni
		}
	}
	return nil
}

// standaloneInboundCount counts the node's operator-managed inbounds (the
// node table's read-only indicator). Chain-entry materializations
// (Source "chain:*") are excluded — they belong to the chain, are rendered
// by the chain machinery, and are not editable from the node row. Inbound
// management lives on the /ui/inbounds page (first-class profiles).
func standaloneInboundCount(info *model.NodeInfo) int {
	if info == nil {
		return 0
	}
	n := 0
	for i := range info.Inbounds {
		if !chain.IsChainSourcedInbound(&info.Inbounds[i]) {
			n++
		}
	}
	return n
}

func findMetric(id string, metrics []*model.NodeMetrics) *model.NodeMetrics {
	for _, m := range metrics {
		if m != nil && m.HostID == id {
			return m
		}
	}
	return nil
}

// NodeStatusCell renders the per-node health cell for the nodes table: a
// health-state badge + a Mark/Clear-blocked button. The block/unblock POST
// handlers (web/nodes.go) swap this cell back in (hx-target="closest td"), so
// the button label + badge update in place after the operator acts. The "Check"
// button (manual status probe) is kept as a secondary action — it fires
// /ui/hosts/{id}/status which now also drives the state machine.
templ NodeStatusCell(id string, m *model.NodeMetrics) {
	{{ state := NodeState(m)
	_ = state }}
	<div class="flex items-center gap-1">
		<span class={ healthBadgeClass(state) }><span class="dot"></span>{ healthBadgeLabel(ctx, state) }</span>
		if state == model.NodeStateBlocked {
			<button
				class="btn btn-ghost btn-xs"
				hx-post={"/ui/nodes/" + id + "/unblock"}
				hx-target="closest td"
				hx-swap="innerHTML">
				{ i18n.T(ctx, "Clear block") }
			</button>
		} else {
			<button
				class="btn btn-ghost btn-xs"
				hx-post={"/ui/nodes/" + id + "/block"}
				hx-target="closest td"
				hx-swap="innerHTML">
				{ i18n.T(ctx, "Mark blocked") }
			</button>
		}
		<button
			class="btn btn-ghost btn-xs"
			hx-get={"/ui/hosts/" + id + "/status"}
			hx-target="closest td"
			hx-swap="innerHTML">
			{ i18n.T(ctx, "Check") }
		</button>
	</div>
}

func niCountry(nodeInfo []*model.NodeInfo) string {
	if len(nodeInfo) > 0 && nodeInfo[0] != nil {
		return nodeInfo[0].Country
	}
	return ""
}

func niBandwidth(nodeInfo []*model.NodeInfo) string {
	if len(nodeInfo) > 0 && nodeInfo[0] != nil {
		return nodeInfo[0].Bandwidth
	}
	return ""
}

func containsStr(slice []string, item string) bool {
	for _, s := range slice {
		if s == item {
			return true
		}
	}
	return false
}

func niSource(nodeInfo []*model.NodeInfo) string {
	if len(nodeInfo) > 0 && nodeInfo[0] != nil {
		return nodeInfo[0].Source
	}
	return ""
}

func niSpare(nodeInfo []*model.NodeInfo) bool {
	return len(nodeInfo) > 0 && nodeInfo[0] != nil && nodeInfo[0].Spare
}

func niAutoRelocate(nodeInfo []*model.NodeInfo) bool {
	return len(nodeInfo) > 0 && nodeInfo[0] != nil && nodeInfo[0].AutoRelocate
}

// defaultKeyName returns the Name of the panel default SSH key (looked up in
// allKeys by ID), or the ID itself if the entry cannot be found (defensive —
// the default id is validated server-side so this is just a render fallback).
func defaultKeyName(settings *model.PanelSettings, allKeys []model.SSHKeyEntry) string {
	for _, k := range allKeys {
		if k.ID == settings.DefaultSSHKeyID {
			return k.Name
		}
	}
	return settings.DefaultSSHKeyID
}

// keyBadge maps a key Source to its localized badge label.
func keyBadge(ctx context.Context, source string) string {
	switch source {
	case model.SourceSystem:
		return i18n.T(ctx, "[System]")
	case model.SourceAuto:
		return i18n.T(ctx, "[Auto]")
	case model.SourceManual:
		return i18n.T(ctx, "[Manual]")
	default:
		return i18n.T(ctx, "[Stored]")
	}
}

// keyFpSuffix renders the " · {fingerprint}" suffix for an option label when a
// fingerprint is present, or an empty string otherwise.
func keyFpSuffix(fp string) string {
	if fp == "" {
		return ""
	}
	return " · " + fp
}


// HostKeyWarning is displayed when an SSH host key changes or is untrusted.
templ HostKeyWarning(host model.Host, newFingerprint string, changed bool) {
	<div class="tn-card max-w-lg mx-auto mt-8" style="border-color: color-mix(in oklab, var(--wa) 55%, transparent); background: color-mix(in oklab, var(--wa) 10%, var(--b2));">
		<div class="flex flex-col gap-2">
			if changed {
				<h2 class="text-xl font-semibold flex items-center gap-2" style="color: var(--wa)"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg> { i18n.T(ctx, "WARNING: Host Key Changed!") }</h2>
				<p>{ i18n.T(ctx, "The SSH key for") } <strong>{ host.Addr }</strong> { i18n.T(ctx, "has changed since the last connection.") }</p>
				<p class="text-sm" style="color: var(--mut)">{ i18n.T(ctx, "This could be due to a server reinstall, or it could be a Man-in-the-Middle attack. Do not proceed unless you know the key was changed intentionally.") }</p>
			} else {
				<h2 class="text-xl font-semibold flex items-center gap-2" style="color: var(--wa)"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-7 h-7"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg> { i18n.T(ctx, "Untrusted Host Key") }</h2>
				<p>{ i18n.T(ctx, "The SSH key for") } <strong>{ host.Addr }</strong> { i18n.T(ctx, "is currently marked as untrusted.") }</p>
			}

			<div class="code break-all my-2">
				<div style="color: var(--mut)">{ i18n.T(ctx, "New Fingerprint:") }</div>
				<div class="font-bold">{ newFingerprint }</div>
			</div>

			<div class="flex justify-end gap-2 mt-2">
				<a href="/ui/nodes" class="btn btn-ghost">{ i18n.T(ctx, "Cancel") }</a>
				<button class="btn btn-error" hx-post={ "/ui/nodes/" + host.ID + "/trust" } hx-vals={ fmt.Sprintf("{\"addr\":\"%s\",\"fingerprint\":\"%s\"}", host.Addr, newFingerprint) } hx-swap="none">{ i18n.T(ctx, "Trust and Continue") }</button>
			</div>
		</div>
	</div>
}

// RelocateForm renders the "relocate this node to a new VPS" modal. The form
// posts to /ui/nodes/{id}/relocate with a new addr (required) + optional new
// SSH user/key. The result renders into #relocate-result (RelocateResult). The
// node's transit material is preserved by RelocateNode, so the help text calls
// that out: other nodes + existing clients are not reconfigured.
templ RelocateForm(host *model.Host, settings *model.PanelSettings, allKeys []model.SSHKeyEntry) {
	<dialog id="relocate-modal" class="modal" open>
		<div class="modal-box">
			<h3 class="text-lg font-semibold mb-1">{ i18n.T(ctx, "Relocate node") }: { host.ID }</h3>
			<div class="text-xs mb-4" style="color: var(--mut)">{ i18n.T(ctx, "Move this node to a new VPS. Its transit keys are reused, so other nodes and existing clients are not reconfigured. Every chain containing this node is re-deployed so the new IP propagates to dependent hops.") }</div>

			<form
				hx-post={ "/ui/nodes/" + host.ID + "/relocate" }
				hx-target="#relocate-result"
				hx-swap="innerHTML"
				class="flex flex-col gap-4">

				<div>
					<label class="lbl">{ i18n.T(ctx, "New address") } · { i18n.T(ctx, "IP:port") }</label>
					<input type="text" name="new_addr" class="inp font-mono" placeholder="1.2.3.4:22" required />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "New SSH user (optional)") } · { i18n.T(ctx, "empty keeps current") }</label>
					<input type="text" name="new_user" class="inp font-mono" placeholder={ host.User } />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "New SSH key (optional)") }</label>
					@sshKeySelect("new_ssh_key_id", host.KeyPath, settings, allKeys)
				</div>

				<div class="flex justify-end gap-2">
					<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Relocate to new VPS") }</button>
				</div>
			</form>
			<div id="relocate-result" class="mt-2"></div>
		</div>
	</dialog>
}

// CloneForm renders the "clone this node to a new VPS" modal (P1b). Mirrors
// RelocateForm but adds a "new node ID" field (required, must not exist). The
// clone gets FRESH identity (new keys/UUID/ShortID) but COPIES the configuration:
// protocol/port/obfuscation, ForUsers (same users), chain Role + ExitTargets
// (same topology shape), country/bandwidth/AutoApply/UseSudo.
templ CloneForm(host *model.Host, settings *model.PanelSettings, allKeys []model.SSHKeyEntry) {
	<dialog id="clone-modal" class="modal" open>
		<div class="modal-box">
			<h3 class="text-lg font-semibold mb-1">{ i18n.T(ctx, "Clone node") }: { host.ID }</h3>
			<div class="text-xs mb-4" style="color: var(--mut)">{ i18n.T(ctx, "Clone this node's config to a new VPS with fresh identity (new keys/UUID). Serves the same users + same exit topology.") }</div>

			<form
				hx-post={ "/ui/nodes/" + host.ID + "/clone" }
				hx-target="#clone-result"
				hx-swap="innerHTML"
				class="flex flex-col gap-4">

				<div>
					<label class="lbl">{ i18n.T(ctx, "New node ID") } · { i18n.T(ctx, "unique, not yet used") }</label>
					<input type="text" name="new_id" class="inp font-mono" placeholder="node-clone-1" required />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "New address") } · { i18n.T(ctx, "IP:port") }</label>
					<input type="text" name="new_addr" class="inp font-mono" placeholder="1.2.3.4:22" required />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "New SSH user (optional)") } · { i18n.T(ctx, "empty keeps current") }</label>
					<input type="text" name="new_user" class="inp font-mono" placeholder={ host.User } />
				</div>

				<div>
					<label class="lbl">{ i18n.T(ctx, "New SSH key (optional)") }</label>
					@sshKeySelect("new_ssh_key_id", host.KeyPath, settings, allKeys)
				</div>

				<div class="flex justify-end gap-2">
					<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Clone to new VPS") }</button>
				</div>
			</form>
			<div id="clone-result" class="mt-2"></div>
		</div>
	</dialog>
}

// CloneResult renders the outcome of a node clone (P1b): source→new ID+addr and,
// per affected chain, whether the re-apply provisioned it. A nil report + a
// non-empty simpleMessage is the error path (validation failure, missing node,
// ID collision). Mirrors RelocateResult (chains.templ).
templ CloneResult(sourceID string, report *chain.CloneReport, simpleMessage string) {
	if report != nil {
		<div class={ "alert " + alertClass(cloneAllSuccess(report)) + " shadow-sm text-sm mb-2" }>
			<div class="w-full">
				<div class="flex justify-between items-start mb-1">
					<strong>{ fmt.Sprintf("%s: %s → %s", i18n.T(ctx, "Clone node"), report.NewID, report.NewAddr) }</strong>
					<button class="btn btn-ghost btn-xs" onclick="this.closest('.alert').remove()">✕</button>
				</div>
				<div class="text-xs opacity-70 mb-1">{ fmt.Sprintf("%s: %s → %s (%s)", sourceID, report.SourceID, report.NewID, report.NewAddr) }</div>
				<div class="space-y-1 text-xs">
					for _, c := range report.Chains {
						<div>
							<span class="font-mono">{ c.Name }</span>
							if c.Success {
								<span class="text-success font-semibold">{ i18n.T(ctx, "OK") }</span>
							} else {
								<span class="text-error font-semibold">{ i18n.T(ctx, "FAIL") }</span>
								if c.Error != "" {
									<span class="opacity-70 max-w-[300px] truncate inline-block align-bottom cursor-pointer"
										onclick="var d=this.nextElementSibling;d.style.display=d.style.display==='none'?'block':'none'"
										title={ i18n.T(ctx, "Click to expand") }> — { c.Error }</span>
									<span class="hidden text-[10px] font-mono opacity-60 mt-1 block max-w-full break-all">{ c.Error }</span>
								}
							}
						</div>
					}
				</div>
			</div>
		</div>
	} else {
		<div class="alert alert-error shadow-sm text-sm mb-2">
			<div class="w-full">
				<div class="flex justify-between items-start mb-1">
					<strong>{ i18n.T(ctx, "Clone node") + ": " + sourceID }</strong>
					<button class="btn btn-ghost btn-xs" onclick="this.closest('.alert').remove()">✕</button>
				</div>
				if simpleMessage != "" {
					<div class="text-xs">{ simpleMessage }</div>
				}
			</div>
		</div>
	}
}

// cloneAllSuccess reports whether every chain re-apply in a clone succeeded.
func cloneAllSuccess(report *chain.CloneReport) bool {
	if report == nil || len(report.Chains) == 0 {
		return false
	}
	for _, c := range report.Chains {
		if !c.Success {
			return false
		}
	}
	return true
}

// AWGDiagnostics renders the deep AWG probe results (chain.DiagnoseAWGNode)
// as a modal: one row per check with an ok/warn/fail badge + the evidence
// read on the node. Pure read-only diagnostics — fixes belong to re-deploy.
templ AWGDiagnostics(nodeID string, checks []chain.DiagCheck) {
	<dialog id="awg-diag-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="text-lg font-semibold mb-1">{ i18n.T(ctx, "AWG diagnostics") }: { nodeID }</h3>
			<div class="text-xs mb-4" style="color: var(--mut)">{ i18n.T(ctx, "Read-only probe of the AWG data plane: interface, handshakes, kernel forwarding rules, sing-box overlay. Fixes belong to re-deploy / node packages.") }</div>
			<div class="flex flex-col gap-2">
				for _, c := range checks {
					<div class="flex items-start gap-2 text-sm">
						if c.Status == chain.DiagOK {
							<span class="st st-ok mt-0.5">OK</span>
						} else if c.Status == chain.DiagWarn {
							<span class="st st-warn mt-0.5">WARN</span>
						} else {
							<span class="st st-err mt-0.5">FAIL</span>
						}
						<div>
							<div class="font-medium">{ c.Name }</div>
							<div class="text-xs break-all" style="color: var(--mut)">{ c.Detail }</div>
						</div>
					</div>
				}
			</div>
			<div class="flex justify-end mt-4">
				<button class="btn btn-sm" onclick="document.getElementById('awg-diag-modal').remove()">{ i18n.T(ctx, "Close") }</button>
			</div>
		</div>
	</dialog>
}

// AWGDiagnosticsError renders a probe that could not run (SSH/connect error).
templ AWGDiagnosticsError(nodeID, msg string) {
	<dialog id="awg-diag-modal" class="modal" open>
		<div class="modal-box">
			<h3 class="text-lg font-semibold mb-4">{ i18n.T(ctx, "AWG diagnostics") }: { nodeID }</h3>
			<div class="alert alert-error"><span>{ msg }</span></div>
			<div class="flex justify-end mt-4">
				<button class="btn btn-sm" onclick="document.getElementById('awg-diag-modal').remove()">{ i18n.T(ctx, "Close") }</button>
			</div>
		</div>
	</dialog>
}
