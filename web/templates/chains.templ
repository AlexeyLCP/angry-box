package templates

import (
	"fmt"
	"time"

	"github.com/alexeylcp/angry-box/internal/chain"
	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// shortHex returns s if its length is within n bytes, else s truncated to n
// bytes followed by an ellipsis. Used to preview long AWG CPS I1-I5 hex strings.
func shortHex(s string, n int) string {
	if len(s) <= n {
		return s
	}
	return s[:n] + "…"
}

// Chains is the main content for /ui/chains.
// It shows existing chains and a button to open the creation modal.
templ Chains(chains []*model.Chain, availableHosts []*model.Host) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Chains") }</h2>
			<button
				class="btn btn-primary btn-sm"
				hx-get="/ui/chains/new"
				hx-target="#modal-container"
				hx-swap="innerHTML"
			>
				{ i18n.T(ctx, "+ Create Chain") }
			</button>
		</div>

		<div role="tablist" class="tabs tabs-bordered">
			<button role="tab" class="tab tab-active">{ i18n.T(ctx, "Chains") }</button>
			<button role="tab" class="tab" hx-get="/ui/spider" hx-target="#chains-tab-content" hx-swap="innerHTML">{ i18n.T(ctx, "Topology") }</button>
		</div>
		<div id="chains-tab-content" class="space-y-6">

		if len(availableHosts) == 0 {
			<div class="alert alert-warning">
				<span>{ i18n.T(ctx, "No hosts registered yet. Add hosts first on the Hosts page before creating chains.") }</span>
			</div>
		}

		<div class="tn-card">
			<div class="w-full overflow-x-clip">
				<table class="tn-table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Name") }</th>
							<th>{ i18n.T(ctx, "Nodes") }</th>
							<th>{ i18n.T(ctx, "Strategy") }</th>
							<th class="w-px"></th>
						</tr>
					</thead>
					<tbody id="chains-tbody">
						for _, c := range chains {
							@ChainRow(c)
						}
						if len(chains) == 0 {
							<tr>
								<td colspan="4" class="text-center py-8 text-base-content/50">
									{ i18n.T(ctx, "No chains yet. Create your first multi-hop proxy chain.") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>

		<!-- Per-chain apply result area (OOB updates land here) -->
		<div id="apply-results" class="space-y-2"></div>
		</div>
	</div>

	<!-- Modal container -->
	<div id="modal-container"></div>
}

// ChainRow renders one row in the chains table. For levelized (v2) chains the
// nodes column shows level groups: [entry nodes] → [next level] → … with the
// level strategy on multi-node groups.
templ ChainRow(c *model.Chain) {
	<tr id={"chain-" + c.Name}>
		<td class="font-semibold text-sm whitespace-normal break-all">{ c.Name }</td>
		<td class="whitespace-normal">
			<div class="flex flex-wrap gap-0.5 items-center">
				if c.IsLevelized() {
					for li, lv := range c.Levels {
						if li > 0 {
							<span class="text-base-content/30 text-[10px] px-0.5">→</span>
						}
						<span class="inline-flex gap-0.5 items-center border border-base-300/60 rounded px-1 py-0.5" title={ levelTitle(lv) }>
							for _, n := range lv.Nodes {
								<span class="badge badge-outline badge-xs font-mono text-[10px] break-all h-auto py-0.5" title={ n.Addr }>{ n.ID }</span>
							}
							if len(lv.Nodes) > 1 && lv.Strategy != "" {
								<span class="text-[9px] text-base-content/50 ml-0.5">{ string(lv.Strategy) }</span>
							}
						</span>
					}
				} else {
					for i, n := range c.Nodes {
						if i < 2 {
							<span class="badge badge-outline badge-xs font-mono text-[10px] break-all h-auto py-0.5" title={ n.Addr }>{ n.ID }</span>
						}
					}
					if len(c.Nodes) > 2 {
						<span class="badge badge-ghost badge-xs text-[10px] h-auto" title={ nodeListStr(c.Nodes) }>+{ moreNodesStr(c.Nodes) }</span>
					}
				}
			</div>
		</td>
		<td class="text-xs whitespace-normal break-all">
			<span class="font-mono">{ c.Strategy }</span>
			if c.Transport != "" {
				<span class="opacity-50">/{ c.Transport }</span>
			}
			if c.UserProtocol != "" {
				<span class="opacity-40 ml-1">({ c.UserProtocol })</span>
			}
		</td>
		<td>
			<div class="flex flex-wrap gap-1">
				<button
					class="btn btn-primary btn-xs"
					hx-post={"/ui/chains/" + c.Name + "/apply"}
					hx-target="#apply-results"
					hx-swap="beforeend"
					hx-indicator={"#apply-spin-" + c.Name}>
					{ i18n.T(ctx, "Apply") }
					<span id={"apply-spin-" + c.Name} class="htmx-indicator loading loading-spinner loading-xs ml-1"></span>
				</button>
				<button
					class="btn btn-ghost btn-xs"
					hx-get={"/ui/chains/" + c.Name + "/edit"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					{ i18n.T(ctx, "Edit") }
				</button>
				<button
					class="btn btn-ghost btn-xs text-error"
					hx-delete={"/ui/chains/" + c.Name}
					hx-confirm={i18n.T(ctx, "Delete chain ") + c.Name + "?"}
					hx-target="closest tr"
					hx-swap="outerHTML">
					{ i18n.T(ctx, "Del") }
				</button>
			</div>
		</td>
	</tr>
}

// ApplyResult supports both simple mode and rich report mode (from backend ApplyReport)
templ ApplyResult(chainName string, success bool, report *chain.ApplyReport, simpleMessage string) {
	<div class={ "alert " + alertClass(success) + " shadow-sm text-sm mb-2" }>
		<div class="w-full">
			<div class="flex justify-between items-start mb-1">
				<strong>{ chainName }</strong>
				<button class="btn btn-ghost btn-xs" onclick="this.closest('.alert').remove()">✕</button>
			</div>

			if report != nil {
				<div class="space-y-1 text-xs">
					for _, n := range report.Nodes {
						<div>
							<span class="font-mono">{ n.ID }</span>
							if n.Success {
								<span class="text-success font-semibold">{ i18n.T(ctx, "OK") }</span>
							} else {
								<span class="text-error font-semibold">{ i18n.T(ctx, "FAIL") }</span>
								if n.Error != "" {
									<span class="opacity-70 max-w-[300px] truncate inline-block align-bottom cursor-pointer"
										onclick="var d=this.nextElementSibling;d.style.display=d.style.display==='none'?'block':'none'"
										title={ i18n.T(ctx, "Click to expand") }> — { n.Error }</span>
									<span class="hidden text-[10px] font-mono opacity-60 mt-1 block max-w-full break-all">{ n.Error }</span>
								}
							}
						</div>
					}

					if success && report.AWG != nil {
						<div class="mt-2 p-2 bg-base-300 rounded font-mono text-[11px]">
							<div class="font-semibold mb-0.5">{ i18n.T(ctx, "AWG Client Keys") }</div>
							<div>{ i18n.T(ctx, "Server Public:") } <span class="select-all">{ report.AWG.ServerPub }</span></div>
							<div>{ i18n.T(ctx, "Client Public:") } <span class="select-all">{ report.AWG.ClientPubUsed }</span></div>
							if report.AWG.ClientPriv != "" {
								<div class="text-warning">{ i18n.T(ctx, "Client Private:") } <span class="select-all">{ report.AWG.ClientPriv }</span></div>
							}
						</div>
					}
				</div>
			} else if simpleMessage != "" {
				<div>{ simpleMessage }</div>
			}
		</div>
	</div>
}

// RelocateResult renders the outcome of a node relocation: which node moved
// (old→new addr) and, per affected chain, whether the re-apply healed it. A
// nil report + non-empty simpleMessage is the error path (unknown node, bad
// addr, missing SSH key). When report is non-nil the overall success is
// derived from whether every chain re-apply succeeded.
templ RelocateResult(nodeID string, report *chain.RelocateReport, simpleMessage string) {
	if report != nil {
		<div class={ "alert " + alertClass(relocateAllSuccess(report)) + " shadow-sm text-sm mb-2" }>
			<div class="w-full">
				<div class="flex justify-between items-start mb-1">
					<strong>{ fmt.Sprintf("%s: %s → %s", i18n.T(ctx, "Relocate node"), nodeID, report.NewAddr) }</strong>
					<button class="btn btn-ghost btn-xs" onclick="this.closest('.alert').remove()">✕</button>
				</div>
				<div class="text-xs opacity-70 mb-1">{ fmt.Sprintf("%s: %s → %s", nodeID, report.OldAddr, report.NewAddr) }</div>
				<div class="space-y-1 text-xs">
					for _, c := range report.Chains {
						<div>
							<span class="font-mono">{ c.Name }</span>
							if c.Success {
								<span class="text-success font-semibold">{ i18n.T(ctx, "OK") }</span>
							} else {
								<span class="text-error font-semibold">{ i18n.T(ctx, "FAIL") }</span>
								if c.Error != "" {
									<span class="opacity-70 max-w-[300px] truncate inline-block align-bottom cursor-pointer"
										onclick="var d=this.nextElementSibling;d.style.display=d.style.display==='none'?'block':'none'"
										title={ i18n.T(ctx, "Click to expand") }> — { c.Error }</span>
									<span class="hidden text-[10px] font-mono opacity-60 mt-1 block max-w-full break-all">{ c.Error }</span>
								}
							}
						</div>
					}
				</div>
			</div>
		</div>
	} else {
		<div class="alert alert-error shadow-sm text-sm mb-2">
			<div class="w-full">
				<div class="flex justify-between items-start mb-1">
					<strong>{ i18n.T(ctx, "Relocate node") + ": " + nodeID }</strong>
					<button class="btn btn-ghost btn-xs" onclick="this.closest('.alert').remove()">✕</button>
				</div>
				if simpleMessage != "" {
					<div class="text-xs">{ simpleMessage }</div>
				}
			</div>
		</div>
	}
}

// relocateAllSuccess reports whether every chain re-apply in a relocate report
// succeeded (drives the top-level alert class).
func relocateAllSuccess(report *chain.RelocateReport) bool {
	if report == nil || len(report.Chains) == 0 {
		return false
	}
	for _, c := range report.Chains {
		if !c.Success {
			return false
		}
	}
	return true
}

func nodeListStr(nodes []model.ChainNode) string {
	s := ""
	for i, n := range nodes {
		if i > 0 { s += ", " }
		s += n.ID
	}
	return s
}

func moreNodesStr(nodes []model.ChainNode) string {
	if len(nodes) <= 2 {
		return ""
	}
	return fmt.Sprintf("%d", len(nodes)-2)
}

// levelTitle summarizes a chain level for the row tooltip.
func levelTitle(lv model.ChainLevel) string {
	s := "level " + lv.ID + ": "
	for i, n := range lv.Nodes {
		if i > 0 {
			s += ", "
		}
		s += n.ID
	}
	if len(lv.Nodes) > 1 && lv.Strategy != "" {
		s += " (strategy: " + string(lv.Strategy) + ")"
	}
	return s
}


func alertClass(success bool) string {
	if success {
		return "alert-success"
	}
	return "alert-error"
}

// Minimal StatusPage for now (hosts with on-demand check)
templ StatusPage(hosts []*model.Host, metrics []*model.NodeMetrics) {
	<div class="space-y-6">
		<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "System Status") }</h2>
		<div class="tn-card">
			<div class="w-full">
				<table class="tn-table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Host") }</th>
							<th>{ i18n.T(ctx, "Address") }</th>
							<th>{ i18n.T(ctx, "Status") }</th>
							<th>{ i18n.T(ctx, "Version") }</th>
							<th>{ i18n.T(ctx, "Last Checked") }</th>
						</tr>
					</thead>
					<tbody>
						for _, h := range hosts {
							<tr>
								<td class="font-mono">{ h.ID }</td>
								<td class="font-mono text-sm">{ h.Addr }</td>
								<td>
									<div hx-get={"/ui/hosts/" + h.ID + "/status"} hx-target="this" hx-swap="innerHTML">
										<button class="btn btn-xs">{ i18n.T(ctx, "Check") }</button>
									</div>
								</td>
								@metricVersionCell(h.ID, metrics)
								@metricLastCheckedCell(h.ID, metrics)
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
		<p class="text-xs opacity-60">{ i18n.T(ctx, "Tip: Use the Nodes page for full management. Auto-refreshes every 60 seconds.") }</p>
		<!-- Auto-refresh every 60s -->
		<div hx-get="/ui/status" hx-trigger="every 60s" hx-target="#main-content" hx-swap="outerHTML" class="hidden"></div>
	</div>
}

templ metricVersionCell(hostID string, metrics []*model.NodeMetrics) {
	<td>
		for _, m := range metrics {
			if m.HostID == hostID && m.Version != "" {
				<span class="font-mono text-xs">{ m.Version }</span>
				return
			}
		}
		<span class="text-base-content/30 text-xs">—</span>
	</td>
}

templ metricLastCheckedCell(hostID string, metrics []*model.NodeMetrics) {
	<td>
		for _, m := range metrics {
			if m.HostID == hostID && !m.LastChecked.IsZero() {
				<span class="text-xs text-base-content/50">{ fmtDuration(time.Since(m.LastChecked)) } { i18n.T(ctx, "ago") }</span>
				return
			}
		}
		<span class="text-xs text-base-content/30">{ i18n.T(ctx, "Never") }</span>
	</td>
}
