package templates

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// UserChainConfig holds a generated config for a specific chain.
type UserChainConfig struct {
	ChainName   string
	Protocol    string
	ConfigLink  string
	Description string
}

// ─── Users List ─────────────────────────────────────────────────────────────────

templ Users(users []*model.User, chains []*model.Chain) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Users") }</h2>
			<button
				class="btn btn-primary btn-sm"
				hx-get="/ui/users/new"
				hx-target="#modal-container"
				hx-swap="innerHTML">
				{ i18n.T(ctx, "+ Add User") }
			</button>
		</div>

		<div class="tn-card">
			<div class="w-full overflow-x-clip">
				<table class="tn-table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Name") }</th>
							<th>{ i18n.T(ctx, "Protocols") }</th>
							<th>{ i18n.T(ctx, "Chains") }</th>
							<th>{ i18n.T(ctx, "Expires") }</th>
							<th>{ i18n.T(ctx, "AWG traffic") }</th>
							<th>{ i18n.T(ctx, "Status") }</th>
							<th class="w-px"></th>
						</tr>
					</thead>
					<tbody id="users-tbody">
						for _, u := range users {
							@UserRow(u)
						}
						if len(users) == 0 {
							<tr>
								<td colspan="6" class="text-center py-8 text-base-content/50">
									{ i18n.T(ctx, "No users yet. Add your first proxy user.") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div id="modal-container"></div>
}

// ─── User Row ──────────────────────────────────────────────────────────────────

templ UserRow(u *model.User) {
	<tr id={"user-" + u.ID}>
		<td>
			<div class="font-semibold">{ u.Name }</div>
			<div class="text-xs text-base-content/50 font-mono">{ u.ID }</div>
		</td>
		<td>
			<div class="flex flex-wrap gap-1">
				for _, p := range u.Protocols {
					<span class="badge badge-outline badge-xs">{ p }</span>
				}
				if u.MTProxySecret != "" {
					<span class="badge badge-warning badge-xs">{ i18n.T(ctx, "MTProxy") }</span>
				}
			</div>
		</td>
		<td>
			<div class="flex flex-wrap gap-1">
				for _, cn := range u.ChainNames {
					<span class="badge badge-ghost badge-xs">{ cn }</span>
				}
				if len(u.ChainNames) == 0 {
					<span class="text-base-content/30 text-xs">{ i18n.T(ctx, "None") }</span>
				}
			</div>
		</td>
		<td>
			if u.ExpiresAt.IsZero() {
				<span class="badge badge-ghost badge-xs">{ i18n.T(ctx, "Never") }</span>
			} else if u.IsExpired() {
				<span class="text-error text-xs">{ u.ExpiresAt.Format("2006-01-02") }</span>
			} else {
				<span class="text-xs">{ fmtDuration(time.Until(u.ExpiresAt)) }</span>
			}
		</td>
		<td>
			if u.AWGRxBytes > 0 || u.AWGTxBytes > 0 {
				<span class="text-xs" title={ i18n.T(ctx, "Down / Up (cumulative, from kernel per-peer counters)") }>{ fmtBytes(u.AWGRxBytes) } ↓ / { fmtBytes(u.AWGTxBytes) } ↑</span>
			} else {
				<span class="text-base-content/30 text-xs">—</span>
			}
		</td>
		<td>
			if status, cls := userStatusBadge(u); status != "" {
				<span class={ "badge badge-xs " + cls }>{ i18n.T(ctx, status) }</span>
			}
		</td>
		<td>
			<div class="flex flex-wrap gap-1">
				<button
					class="btn btn-ghost btn-xs"
					hx-get={"/ui/users/" + u.ID + "/config"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					{ i18n.T(ctx, "Config") }
				</button>
				<button
					class="btn btn-ghost btn-xs"
					hx-get={"/ui/users/" + u.ID + "/qr"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					{ i18n.T(ctx, "QR") }
				</button>
				<button
					class="btn btn-ghost btn-xs"
					hx-get={"/ui/users/" + u.ID + "/edit"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					{ i18n.T(ctx, "Edit") }
				</button>
				<button
					class="btn btn-ghost btn-xs text-error"
					hx-delete={"/ui/users/" + u.ID}
					hx-confirm={i18n.T(ctx, "Delete user ") + u.Name + "?"}
					hx-target="closest tr"
					hx-swap="outerHTML">
					{ i18n.T(ctx, "Delete") }
				</button>
			</div>
		</td>
	</tr>
}

// ─── User Form (create / edit) ─────────────────────────────────────────────────

templ UserForm(u *model.User, chains []*model.Chain, subHost string) {
	<dialog id="user-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="font-bold text-lg mb-4">
				if u != nil {
					{ i18n.T(ctx, "Edit Client: ") }{ u.Name }
				} else {
					{ i18n.T(ctx, "Add Client") }
				}
			</h3>

			if u != nil {
				<form
					hx-post={"/ui/users/" + u.ID + "/edit"}
					hx-target={"#user-" + u.ID}
					hx-swap="outerHTML"
					hx-on::after-request="this.closest('dialog').close()"
					class="space-y-4">
					@userFormBody(u, chains)
					<div class="modal-action">
						<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Save") }</button>
					</div>
				</form>
			} else {
				<form
					hx-post="/ui/users"
					hx-target="#users-tbody"
					hx-swap="beforeend"
					hx-on::after-request="this.closest('dialog').close(); this.reset()"
					class="space-y-4">
					@userFormBody(nil, chains)
					<div class="modal-action">
						<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Create Client") }</button>
					</div>
				</form>
			}
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// userFormBody is the simplified client form (v0.8): name + chains, everything
// else behind one Advanced disclosure. The system derives credentials from the
// selected chains (AWG peer / VLESS UUID) — no protocols to pick, no wizard,
// no services.
templ userFormBody(u *model.User, chains []*model.Chain) {
	<div class="grid grid-cols-2 gap-4">
		if u == nil {
			<div class="form-control">
				<label class="label"><span class="label-text">{ i18n.T(ctx, "ID (unique)") }</span></label>
				<input type="text" name="id" class="input input-bordered" required placeholder="user1" />
			</div>
		}
		<div class="form-control">
			<label class="label"><span class="label-text">{ i18n.T(ctx, "Name") }</span></label>
			<input type="text" name="name" class="input input-bordered" required
				if u != nil { value={ u.Name } } placeholder="John Doe" />
		</div>
	</div>

	<div class="form-control">
		<label class="label"><span class="label-text">{ i18n.T(ctx, "Chains") }</span></label>
		<div class="space-y-1 max-h-56 overflow-y-auto border border-base-300 rounded-lg p-3">
			if len(chains) == 0 {
				<span class="text-sm text-base-content/50">{ i18n.T(ctx, "No chains available. Create chains first.") }</span>
			}
			for _, c := range chains {
				<div>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="chains" value={ c.Name } class="checkbox checkbox-sm"
							if u == nil || containsProtocol(u.ChainNames, c.Name) { checked } />
						<span class="text-sm font-mono">{ c.Name }</span>
						<span class="text-xs text-base-content/40">({ fmt.Sprintf("%d %s", len(c.AllNodes()), i18n.T(ctx, "hops")) } · { c.UserProtocol })</span>
					</label>
					if u != nil && containsProtocol(u.ChainNames, c.Name) {
						<div class="ml-6 flex items-center gap-2">
							<span class="text-xs text-base-content/50">{ i18n.T(ctx, "Exit node") }:</span>
							<select name={ "exit_" + c.Name } class="select select-bordered select-xs">
								<option value="">{ i18n.T(ctx, "default") }</option>
								for _, n := range c.AllNodes() {
									<option value={ n.ID } if u.ChainExit != nil && u.ChainExit[c.Name] == n.ID { selected }>{ n.ID }</option>
								}
							</select>
						</div>
					}
				</div>
			}
		</div>
		<label class="label"><span class="label-text-alt text-base-content/50">{ i18n.T(ctx, "Credentials (AWG peer, VLESS UUID) are generated automatically from the selected chains.") }</span></label>
	</div>

	if u != nil {
		<label class="flex items-center gap-2 cursor-pointer">
			<input type="checkbox" name="active" class="checkbox checkbox-sm"
				if u.Active { checked } />
			<span class="label-text">{ i18n.T(ctx, "Active") }</span>
		</label>
	} else {
		<input type="hidden" name="active" value="on" />
	}

	<details class="collapse collapse-arrow border border-base-300 rounded-lg">
		<summary class="collapse-title font-medium text-sm">{ i18n.T(ctx, "Advanced (contacts, expiry, quota, MTProxy, import)") }</summary>
		<div class="collapse-content space-y-4">
			<div class="grid grid-cols-2 gap-4">
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Telegram (optional)") }</span></label>
					<input type="text" name="telegram" class="input input-bordered input-sm"
						if u != nil { value={ u.Telegram } } placeholder="@username" />
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Email (optional)") }</span></label>
					<input type="email" name="email" class="input input-bordered input-sm"
						if u != nil { value={ u.Email } } placeholder="user@example.com" />
				</div>
			</div>

			<div class="form-control">
				<label class="label"><span class="label-text">{ i18n.T(ctx, "Expire strategy") }</span></label>
				<select name="expire_strategy" class="select select-bordered select-sm">
					<option value="never" if u == nil || u.ExpireStrategy == "" || u.ExpireStrategy == "never" { selected }>{ i18n.T(ctx, "Never") }</option>
					<option value="fixed_date" if u != nil && u.ExpireStrategy == "fixed_date" { selected }>{ i18n.T(ctx, "Fixed date") }</option>
					<option value="start_on_first_use" if u != nil && u.ExpireStrategy == "start_on_first_use" { selected }>{ i18n.T(ctx, "Start on first use") }</option>
				</select>
			</div>
			<div class="grid grid-cols-3 gap-4">
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Expires At") }</span></label>
					<input type="date" name="expires_at" class="input input-bordered input-sm"
						if u != nil && !u.ExpiresAt.IsZero() { value={ u.ExpiresAt.Format("2006-01-02") } } />
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Usage duration (seconds)") }</span></label>
					<input type="number" name="usage_duration" class="input input-bordered input-sm"
						if u != nil && u.UsageDuration != 0 { value={ fmt.Sprintf("%d", u.UsageDuration) } } />
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Activation deadline") }</span></label>
					<input type="date" name="activation_deadline" class="input input-bordered input-sm"
						if u != nil && !u.ActivationDeadline.IsZero() { value={ u.ActivationDeadline.Format("2006-01-02") } } />
				</div>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Data limit (bytes, 0 = unlimited)") }</span></label>
					<input type="number" name="data_limit" class="input input-bordered input-sm"
						if u != nil && u.DataLimit != 0 { value={ fmt.Sprintf("%d", u.DataLimit) } } placeholder="0" />
				</div>
				<div class="form-control">
					<label class="label"><span class="label-text">{ i18n.T(ctx, "Data limit reset strategy") }</span></label>
					<select name="data_limit_reset_strategy" class="select select-bordered select-sm">
						<option value="no_reset" if u == nil || u.DataLimitResetStrategy == "" || u.DataLimitResetStrategy == "no_reset" { selected }>{ i18n.T(ctx, "No reset") }</option>
						<option value="day" if u != nil && u.DataLimitResetStrategy == "day" { selected }>{ i18n.T(ctx, "Daily") }</option>
						<option value="week" if u != nil && u.DataLimitResetStrategy == "week" { selected }>{ i18n.T(ctx, "Weekly") }</option>
						<option value="month" if u != nil && u.DataLimitResetStrategy == "month" { selected }>{ i18n.T(ctx, "Monthly") }</option>
					</select>
				</div>
			</div>

			<div class="form-control">
				<label class="label"><span class="label-text">{ i18n.T(ctx, "Import Secret (optional)") }</span></label>
				<select name="secret_type" class="select select-bordered select-sm mb-2">
					<option value="" if u == nil || u.SecretType == "" { selected }>{ i18n.T(ctx, "None") }</option>
					<option value="telemt" if u != nil && u.SecretType == "telemt" { selected }>{ i18n.T(ctx, "Telemt (MTProto) — Secret") }</option>
					if u != nil && u.SecretType != "" && u.SecretType != "telemt" {
						<option value={ u.SecretType } selected disabled>{ i18n.T(ctx, "Legacy import (edit-only)") }: { u.SecretType }</option>
					}
				</select>
				<input type="text" name="imported_secret" class="input input-bordered input-sm font-mono"
					if u != nil { value={ u.ImportedSecret } } placeholder={ i18n.T(ctx, "Paste your existing key here...") } />
			</div>

			<div class="collapse collapse-arrow border border-base-300 rounded-lg">
				<input type="checkbox" name="mtproxy_enabled" class="peer" if u != nil && u.MTProxySecret != "" { checked } />
				<div class="collapse-title font-medium text-sm">
					{ i18n.T(ctx, "MTProxy (Telegram FakeTLS)") }
				</div>
				<div class="collapse-content space-y-3">
					<div class="join">
						<input type="text" name="mtproxy_secret" class="input input-bordered input-sm join-item font-mono"
							if u != nil { value={ u.MTProxySecret } } maxlength="32" placeholder={ i18n.T(ctx, "Generate MTProxy Secret") } />
						<button type="button" class="btn btn-sm join-item"
							hx-post="/ui/users/generate-mtproxy-secret"
							hx-target="[name='mtproxy_secret']"
							hx-swap="outerHTML">
							{ i18n.T(ctx, "Generate") }
						</button>
					</div>
					<div class="form-control">
						<label class="label"><span class="label-text">{ i18n.T(ctx, "FakeTLS Domain") }</span></label>
						<input type="text" name="mtproxy_domain" class="input input-bordered input-sm"
							if u != nil && u.MTProxyDomain != "" { value={ u.MTProxyDomain } } else { value="disk.yandex.ru" } />
					</div>
					<div class="form-control">
						<label class="label"><span class="label-text">{ i18n.T(ctx, "Order Index") }</span></label>
						<input type="number" name="mtproxy_order_index" class="input input-bordered input-sm"
							if u != nil && u.MTProxyOrderIndex != 0 { value={ fmt.Sprintf("%d", u.MTProxyOrderIndex) } } />
					</div>
					<div class="form-control">
						<label class="label"><span class="label-text">{ i18n.T(ctx, "MTProxy Nodes") }</span></label>
						<select name="mtproxy_nodes" multiple class="select select-bordered select-sm" size="4">
							if len(chains) == 0 {
								<option disabled>{ i18n.T(ctx, "Add a node first") }</option>
							}
							for _, c := range chains {
								for _, n := range c.AllNodes() {
									<option value={ n.ID } if u != nil && containsProtocol(u.MTProxyNodes, n.ID) { selected }>{ n.ID }</option>
								}
							}
						</select>
					</div>
				</div>
			</div>
		</div>
	</details>
}

// ─── User Config View ──────────────────────────────────────────────────────────

templ UserConfigView(u *model.User, configs []UserChainConfig) {
	<dialog id="config-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="font-bold text-lg mb-2">{ i18n.T(ctx, "Configs for ") }{ u.Name }</h3>
			<div class="text-xs text-base-content/50 font-mono mb-4">{ u.ID }</div>

			if len(configs) == 0 {
				<div class="alert alert-warning">
					<span>{ i18n.T(ctx, "No configs available. Assign chains to this user first.") }</span>
				</div>
			} else {
				<div class="space-y-3">
					for _, cfg := range configs {
						<div class="border border-base-300 rounded-lg p-3">
							<div class="flex items-center justify-between mb-2">
								<div class="font-semibold text-sm">{ cfg.ChainName }</div>
								<span class="badge badge-outline badge-xs">{ cfg.Protocol }</span>
							</div>
							<div class="text-xs text-base-content/50 mb-2">{ cfg.Description }</div>
							<div class="relative">
								<textarea
									rows="2"
									readonly
									class="textarea textarea-bordered w-full text-xs font-mono bg-base-200 resize-none">{ cfg.ConfigLink }</textarea>
								<button
									class="btn btn-xs btn-ghost absolute top-1 right-1"
									onclick="var ta=this.parentElement.querySelector('textarea'); ta.select(); navigator.clipboard.writeText(ta.value);">
									{ i18n.T(ctx, "Copy") }
								</button>
							</div>
							<div class="flex justify-end mt-2">
								<button
									type="button"
									class="btn btn-xs btn-outline"
									onclick="downloadUserConfig(this)"
									data-filename={ fmt.Sprintf("%s-%s.conf", u.Name, cfg.ChainName) }>
									{ i18n.T(ctx, "Download") }
								</button>
							</div>
						</div>
					}
				</div>
			}

			<div class="modal-action">
				<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Close") }</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// ─── User QR View ──────────────────────────────────────────────────────────────

templ UserQRView(u *model.User, links []string) {
	<dialog id="qr-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="font-bold text-lg mb-2">{ i18n.T(ctx, "QR Codes for ") }{ u.Name }</h3>
			<div class="text-xs text-base-content/50 font-mono mb-4">{ u.ID }</div>

			if len(links) == 0 {
				<div class="alert alert-warning">
					<span>{ i18n.T(ctx, "No connection links available.") }</span>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					for _, link := range links {
						if !strings.HasPrefix(link, "#") {
							<div class="border border-base-300 rounded-lg p-3 text-center">
								<div class="text-xs font-mono mb-2 truncate" title={ link }>
									{ ellipsis(link, 50) }
								</div>
								<!-- QR code placeholder: use external API or JS for real QR -->
								<div class="bg-white p-2 inline-block rounded">
									<img
										src={ templ.URL("/ui/qr-image?data=" + url.QueryEscape(link)) }
										alt={ i18n.T(ctx, "QR Code") }
										width="150"
										height="150"
										{ templ.Attributes{"onerror": fmt.Sprintf("this.src='data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"150\" height=\"150\"><rect width=\"150\" height=\"150\" fill=\"#ddd\"/><text x=\"50%%\" y=\"50%%\" text-anchor=\"middle\" dy=\".3em\" font-size=\"12\" fill=\"#999\">%s</text></svg>'", i18n.T(ctx, "QR unavailable"))}... }
									/>
								</div>
								<div class="text-xs mt-1">
									<a href={ link } target="_blank" class="link link-primary">{ i18n.T(ctx, "Open Link") }</a>
								</div>
							</div>
						}
					}
				</div>
			}

			<div class="modal-action">
				<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Close") }</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// ─── Helpers ────────────────────────────────────────────────────────────────────

func containsProtocol(slice []string, item string) bool {
	for _, s := range slice {
		if s == item {
			return true
		}
	}
	return false
}

func safeJS(s string) string {
	// Escape single quotes for JS embed
	return strings.ReplaceAll(s, "'", "\\'")
}

func ellipsis(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen] + "..."
}

// fmtBytes renders a byte count compactly for the traffic column (KiB/MiB/GiB).
func fmtBytes(n int64) string {
	const unit = 1024
	if n < unit {
		return fmt.Sprintf("%d B", n)
	}
	div, exp := int64(unit), 0
	for x := n / unit; x >= unit; x /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %ciB", float64(n)/float64(div), "KMGTPE"[exp])
}

func fmtDuration(d time.Duration) string {
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm", int(d.Minutes()))
	}
	days := int(d.Hours()) / 24
	hours := int(d.Hours()) % 24
	if days > 0 {
		return fmt.Sprintf("%dd%dh", days, hours)
	}
	return fmt.Sprintf("%dh", hours)
}

// displayShow returns "block" when show is true, "none" otherwise — a helper
// for templ.KV("display", ...) style toggles (templ expressions do not accept
// Go's ?: ternary, so this centralizes the conditional).
func displayShow(show bool) string {
	if show {
		return "block"
	}
	return "none"
}

// userStatusBadge returns the i18n status label + DaisyUI badge class for a
// user. Prefers the persisted u.Status (set by handlers via ComputeStatus);
// falls back to deriving on the fly so the list renders correctly even for
// users loaded before the Status field existed (legacy/empty).
func userStatusBadge(u *model.User) (label, class string) {
	status := u.Status
	if status == "" {
		status = u.ComputeStatus()
	}
	switch status {
	case "active":
		return "Active", "badge-success"
	case "disabled":
		return "Inactive", "badge-ghost"
	case "expired":
		return "Expired", "badge-error"
	case "on_hold":
		return "On hold", "badge-warning"
	case "limited":
		return "Limited", "badge-warning"
	default:
		return "Inactive", "badge-ghost"
	}
}

// ─── User Created Result (post-create sub URL box) ─────────────────────────────

// UserCreatedResult is the HTMX response to a successful user create: a row
// replacement showing the user's new Subscription URL with Copy/QR buttons
// (reuses the copy-onclick pattern + /ui/qr-image route). Rendered instead of
// UserRow on create so the operator immediately gets the shareable URL.
// subURL is the full https://host/sub/{token} string built by the handler.
templ UserCreatedResult(u *model.User, subURL string) {
	<tr id={ "user-" + u.ID }>
		<td colspan="5" class="bg-success/10">
			<div class="p-3 space-y-2">
				<div class="font-medium">{ u.Name }</div>
				<div class="text-xs text-base-content/60">{ i18n.T(ctx, "Subscription URL") }</div>
				<div class="join w-full">
					<input type="text" class="input input-bordered join-item input-sm font-mono w-full" value={ subURL } readonly id={ "sub-" + u.ID } />
					<button type="button" class="btn join-item btn-sm" onclick="copySubURL(this)" data-target={ "sub-" + u.ID } data-copied={ i18n.T(ctx, "Copied") }>{ i18n.T(ctx, "Copy") }</button>
					<button type="button" class="btn join-item btn-sm" hx-get={ "/ui/qr-image?data=" + url.QueryEscape(subURL) } hx-target="#qr-modal-container">{ i18n.T(ctx, "QR") }</button>
				</div>
				<div class="text-xs text-base-content/40">{ i18n.T(ctx, "Paste this into your client (v2rayNG/Nekoray/sing-box).") }</div>
			</div>
		</td>
	</tr>
}
