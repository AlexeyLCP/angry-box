package templates

import (
	"fmt"
	"net/url"
	"strings"
	"time"

	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// UserChainConfig holds a generated config for a specific chain.
type UserChainConfig struct {
	ChainName   string
	Protocol    string
	ConfigLink  string
	Description string
}

// ─── Users List ─────────────────────────────────────────────────────────────────

templ Users(users []*model.User, chains []*model.Chain) {
	<div class="flex flex-col gap-6">
		<div class="flex items-center justify-between flex-wrap gap-3">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Users") }</h2>
			<div class="inline-flex gap-2">
				<button
					class="btn btn-outline btn-sm"
					hx-get="/ui/users/bulk"
					hx-target="#modal-container"
					hx-swap="innerHTML">
					{ i18n.T(ctx, "Bulk Add") }
				</button>
				<button
					class="btn btn-primary btn-sm"
					hx-get="/ui/users/new"
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.5v15m7.5-7.5h-15" /></svg>
					{ i18n.T(ctx, "Add User") }
				</button>
			</div>
		</div>

		<section class="tn-card tn-card-hover">
			<div class="overflow-x-auto">
				<table class="tn-table">
					<thead>
						<tr>
							<th>{ i18n.T(ctx, "Name") }</th>
							<th>{ i18n.T(ctx, "Protocols") }</th>
							<th>{ i18n.T(ctx, "Chains") }</th>
							<th>{ i18n.T(ctx, "Expires") }</th>
							<th>{ i18n.T(ctx, "AWG traffic") }</th>
							<th>{ i18n.T(ctx, "Status") }</th>
							<th class="text-right">{ i18n.T(ctx, "Actions") }</th>
						</tr>
					</thead>
					<tbody id="users-tbody">
						for _, u := range users {
							@UserRow(u)
						}
						if len(users) == 0 {
							<tr>
								<td colspan="7" class="text-center py-8" style="color: var(--mut)">
									{ i18n.T(ctx, "No users yet. Add your first proxy user.") }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	</div>

	<div id="modal-container"></div>
}

// ─── User Row ──────────────────────────────────────────────────────────────────

templ UserRow(u *model.User) {
	<tr id={"user-" + u.ID}>
		<td>
			<div class="font-semibold">
				{ u.Name }
				if userOnline(u) {
					<span class="pill" style="color: var(--ok)" title={ i18n.T(ctx, "Last AWG traffic within the online window") }>{ i18n.T(ctx, "online") }</span>
				}
			</div>
			<div class="text-[11px] font-mono" style="color: var(--mut2)">{ u.ID }</div>
		</td>
		<td>
			<div class="flex flex-wrap gap-1">
				for _, p := range u.Protocols {
					<span class="pill">{ p }</span>
				}
				if u.MTProxySecret != "" {
					<span class="pill" style="color: var(--wa)">{ i18n.T(ctx, "MTProxy") }</span>
				}
			</div>
		</td>
		<td>
			<div class="flex flex-wrap gap-1">
				for _, cn := range u.ChainNames {
					<span class="pill" style="color: var(--pu, var(--a))">{ cn }</span>
				}
				if len(u.ChainNames) == 0 {
					<span class="pill" style="color: var(--mut2)">{ i18n.T(ctx, "None") }</span>
				}
			</div>
		</td>
		<td>
			if u.ExpiresAt.IsZero() {
				<span class="pill" style="color: var(--mut2)">{ i18n.T(ctx, "Never") }</span>
			} else if u.IsExpired() {
				<span class="text-xs font-mono" style="color: var(--er)">{ u.ExpiresAt.Format("2006-01-02") }</span>
			} else {
				<span class="text-xs font-mono">{ fmtDuration(time.Until(u.ExpiresAt)) }</span>
			}
		</td>
		<td>
			if u.AWGRxBytes > 0 || u.AWGTxBytes > 0 {
				<span class="text-xs font-mono" title={ i18n.T(ctx, "Down / Up (cumulative, from kernel per-peer counters)") }>{ fmtBytes(u.AWGRxBytes) } ↓ / { fmtBytes(u.AWGTxBytes) } ↑</span>
				if u.AWGRxRate > 0 || u.AWGTxRate > 0 {
					<span class="text-xs font-mono" style="color: var(--mut2)"> { fmtBytes(u.AWGRxRate) }/s ↓ { fmtBytes(u.AWGTxRate) }/s ↑</span>
				}
			} else {
				<span class="pill" style="color: var(--mut2)">—</span>
			}
		</td>
		<td>
			if status, cls := userStatusBadge(u); status != "" {
				<span class={ "st " + cls }><span class="dot"></span>{ i18n.T(ctx, status) }</span>
			}
		</td>
		<td class="text-right whitespace-nowrap">
			<div class="inline-flex gap-1 items-center">
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Config") }
					aria-label={ i18n.T(ctx, "Config") }
					hx-get={"/ui/users/" + u.ID + "/config"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "QR") }
					aria-label={ i18n.T(ctx, "QR") }
					hx-get={"/ui/users/" + u.ID + "/qr"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z" /></svg>
				</button>
				<button
					class="btn-icon"
					title={ i18n.T(ctx, "Edit") }
					aria-label={ i18n.T(ctx, "Edit") }
					hx-get={"/ui/users/" + u.ID + "/edit"}
					hx-target="#modal-container"
					hx-swap="innerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" /></svg>
				</button>
				<button
					class="btn-icon"
					style="color: var(--er)"
					title={ i18n.T(ctx, "Delete") }
					aria-label={ i18n.T(ctx, "Delete") }
					hx-delete={"/ui/users/" + u.ID}
					hx-confirm={i18n.T(ctx, "Delete user ") + u.Name + "?"}
					hx-target="closest tr"
					hx-swap="outerHTML">
					<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
				</button>
			</div>
		</td>
	</tr>
}

// ─── User Form (create / edit) ─────────────────────────────────────────────────

templ UserForm(u *model.User, chains []*model.Chain, subHost string) {
	<dialog id="user-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="text-lg font-semibold mb-4">
				if u != nil {
					{ i18n.T(ctx, "Edit Client: ") }{ u.Name }
				} else {
					{ i18n.T(ctx, "Add Client") }
				}
			</h3>

			if u != nil {
				<form
					hx-post={"/ui/users/" + u.ID + "/edit"}
					hx-target={"#user-" + u.ID}
					hx-swap="outerHTML"
					hx-on::after-request="this.closest('dialog').close()"
					class="flex flex-col gap-4">
					@userFormBody(u, chains)
					<div class="flex justify-end gap-2">
						<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Save") }</button>
					</div>
				</form>
			} else {
				<form
					hx-post="/ui/users"
					hx-target="#users-tbody"
					hx-swap="beforeend"
					hx-on::after-request="this.closest('dialog').close(); this.reset()"
					class="flex flex-col gap-4">
					@userFormBody(nil, chains)
					<div class="flex justify-end gap-2">
						<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
						<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Create Client") }</button>
					</div>
				</form>
			}
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// userFormBody is the simplified client form (v0.8): name + chains, everything
// else behind one Advanced disclosure. The system derives credentials from the
// selected chains (AWG peer / VLESS UUID) — no protocols to pick, no wizard,
// no services.
templ userFormBody(u *model.User, chains []*model.Chain) {
	<div class="grid grid-cols-2 gap-4">
		if u == nil {
			<div>
				<label class="lbl">{ i18n.T(ctx, "ID (unique)") }</label>
				<input type="text" name="id" class="inp" required placeholder="user1" />
			</div>
		}
		<div>
			<label class="lbl">{ i18n.T(ctx, "Name") }</label>
			<input type="text" name="name" class="inp" required
				if u != nil { value={ u.Name } } placeholder="John Doe" />
		</div>
	</div>

	<div>
		<label class="lbl">{ i18n.T(ctx, "Chains") }</label>
		<div class="flex flex-col gap-1 max-h-56 overflow-y-auto p-3" style="border: 1px solid var(--bd); border-radius: 8px;">
			if len(chains) == 0 {
				<span class="text-sm" style="color: var(--mut)">{ i18n.T(ctx, "No chains available. Create chains first.") }</span>
			}
			for _, c := range chains {
				<div>
					<label class="flex items-center gap-2 cursor-pointer">
						<input type="checkbox" name="chains" value={ c.Name } class="cb"
							if u == nil || containsProtocol(u.ChainNames, c.Name) { checked } />
						<span class="text-sm font-mono">{ c.Name }</span>
						<span class="text-xs" style="color: var(--mut2)">({ fmt.Sprintf("%d %s", len(c.AllNodes()), i18n.T(ctx, "hops")) } · { c.UserProtocol })</span>
					</label>
					if u != nil && containsProtocol(u.ChainNames, c.Name) {
						<div class="ml-6 flex items-center gap-2">
							<span class="text-xs" style="color: var(--mut)">{ i18n.T(ctx, "Exit node") }:</span>
							<select name={ "exit_" + c.Name } class="sel" style="padding: 0.15rem 0.4rem; font-size: 12px;">
								<option value="">{ i18n.T(ctx, "default") }</option>
								for _, n := range c.AllNodes() {
									<option value={ n.ID } if u.ChainExit != nil && u.ChainExit[c.Name] == n.ID { selected }>{ n.ID }</option>
								}
							</select>
						</div>
					}
				</div>
			}
		</div>
		<p class="hint">{ i18n.T(ctx, "Credentials (AWG peer, VLESS UUID) are generated automatically from the selected chains.") }</p>
	</div>

	if u != nil {
		<label class="flex items-center gap-2 cursor-pointer">
			<input type="checkbox" name="active" class="cb"
				if u.Active { checked } />
			<span class="text-sm">{ i18n.T(ctx, "Active") }</span>
		</label>
	} else {
		<input type="hidden" name="active" value="on" />
	}

	<details class="collapse collapse-arrow" style="border: 1px solid var(--bd); border-radius: 8px;">
		<summary class="collapse-title font-medium text-sm">{ i18n.T(ctx, "Advanced (contacts, expiry, quota, MTProxy, import)") }</summary>
		<div class="collapse-content flex flex-col gap-4">
			<div class="grid grid-cols-2 gap-4">
				<div>
					<label class="lbl">{ i18n.T(ctx, "Telegram (optional)") }</label>
					<input type="text" name="telegram" class="inp"
						if u != nil { value={ u.Telegram } } placeholder="@username" />
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Email (optional)") }</label>
					<input type="email" name="email" class="inp"
						if u != nil { value={ u.Email } } placeholder="user@example.com" />
				</div>
			</div>

			<div>
				<label class="lbl">{ i18n.T(ctx, "Expire strategy") }</label>
				<select name="expire_strategy" class="sel">
					<option value="never" if u == nil || u.ExpireStrategy == "" || u.ExpireStrategy == "never" { selected }>{ i18n.T(ctx, "Never") }</option>
					<option value="fixed_date" if u != nil && u.ExpireStrategy == "fixed_date" { selected }>{ i18n.T(ctx, "Fixed date") }</option>
					<option value="start_on_first_use" if u != nil && u.ExpireStrategy == "start_on_first_use" { selected }>{ i18n.T(ctx, "Start on first use") }</option>
				</select>
			</div>
			<div class="grid grid-cols-3 gap-4">
				<div>
					<label class="lbl">{ i18n.T(ctx, "Expires At") }</label>
					<input type="date" name="expires_at" class="inp"
						if u != nil && !u.ExpiresAt.IsZero() { value={ u.ExpiresAt.Format("2006-01-02") } } />
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Usage duration (seconds)") }</label>
					<input type="number" name="usage_duration" class="inp"
						if u != nil && u.UsageDuration != 0 { value={ fmt.Sprintf("%d", u.UsageDuration) } } />
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Activation deadline") }</label>
					<input type="date" name="activation_deadline" class="inp"
						if u != nil && !u.ActivationDeadline.IsZero() { value={ u.ActivationDeadline.Format("2006-01-02") } } />
				</div>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<div>
					<label class="lbl">{ i18n.T(ctx, "Data limit (bytes, 0 = unlimited)") }</label>
					<input type="number" name="data_limit" class="inp"
						if u != nil && u.DataLimit != 0 { value={ fmt.Sprintf("%d", u.DataLimit) } } placeholder="0" />
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Data limit reset strategy") }</label>
					<select name="data_limit_reset_strategy" class="sel">
						<option value="no_reset" if u == nil || u.DataLimitResetStrategy == "" || u.DataLimitResetStrategy == "no_reset" { selected }>{ i18n.T(ctx, "No reset") }</option>
						<option value="day" if u != nil && u.DataLimitResetStrategy == "day" { selected }>{ i18n.T(ctx, "Daily") }</option>
						<option value="week" if u != nil && u.DataLimitResetStrategy == "week" { selected }>{ i18n.T(ctx, "Weekly") }</option>
						<option value="month" if u != nil && u.DataLimitResetStrategy == "month" { selected }>{ i18n.T(ctx, "Monthly") }</option>
					</select>
				</div>
			</div>

			<div>
				<label class="lbl">{ i18n.T(ctx, "Import Secret (optional)") }</label>
				<select name="secret_type" class="sel mb-2">
					<option value="" if u == nil || u.SecretType == "" { selected }>{ i18n.T(ctx, "None") }</option>
					<option value="telemt" if u != nil && u.SecretType == "telemt" { selected }>{ i18n.T(ctx, "Telemt (MTProto) — Secret") }</option>
					if u != nil && u.SecretType != "" && u.SecretType != "telemt" {
						<option value={ u.SecretType } selected disabled>{ i18n.T(ctx, "Legacy import (edit-only)") }: { u.SecretType }</option>
					}
				</select>
				<input type="text" name="imported_secret" class="inp font-mono"
					if u != nil { value={ u.ImportedSecret } } placeholder={ i18n.T(ctx, "Paste your existing key here...") } />
			</div>

			<div class="collapse collapse-arrow" style="border: 1px solid var(--bd); border-radius: 8px;">
				<input type="checkbox" name="mtproxy_enabled" class="peer" if u != nil && u.MTProxySecret != "" { checked } />
				<div class="collapse-title font-medium text-sm">
					{ i18n.T(ctx, "MTProxy (Telegram FakeTLS)") }
				</div>
				<div class="collapse-content flex flex-col gap-3">
					<div class="join">
						<input type="text" name="mtproxy_secret" class="inp join-item font-mono"
							if u != nil { value={ u.MTProxySecret } } maxlength="32" placeholder={ i18n.T(ctx, "Generate MTProxy Secret") } />
						<button type="button" class="btn btn-sm btn-outline join-item"
							hx-post="/ui/users/generate-mtproxy-secret"
							hx-target="[name='mtproxy_secret']"
							hx-swap="outerHTML">
							{ i18n.T(ctx, "Generate") }
						</button>
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "FakeTLS Domain") }</label>
						<input type="text" name="mtproxy_domain" class="inp"
							if u != nil && u.MTProxyDomain != "" { value={ u.MTProxyDomain } } else { value="disk.yandex.ru" } />
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "Order Index") }</label>
						<input type="number" name="mtproxy_order_index" class="inp"
							if u != nil && u.MTProxyOrderIndex != 0 { value={ fmt.Sprintf("%d", u.MTProxyOrderIndex) } } />
					</div>
					<div>
						<label class="lbl">{ i18n.T(ctx, "MTProxy Nodes") }</label>
						<select name="mtproxy_nodes" multiple class="sel" size="4">
							if len(chains) == 0 {
								<option disabled>{ i18n.T(ctx, "Add a node first") }</option>
							}
							for _, c := range chains {
								for _, n := range c.AllNodes() {
									<option value={ n.ID } if u != nil && containsProtocol(u.MTProxyNodes, n.ID) { selected }>{ n.ID }</option>
								}
							}
						</select>
					</div>
				</div>
			</div>
		</div>
	</details>
}

// ─── User Config View ──────────────────────────────────────────────────────────

templ UserConfigView(u *model.User, configs []UserChainConfig) {
	<dialog id="config-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="text-lg font-semibold mb-1">{ i18n.T(ctx, "Configs for ") }{ u.Name }</h3>
			<div class="text-xs font-mono mb-4" style="color: var(--mut2)">{ u.ID }</div>

			if len(configs) == 0 {
				<div class="alert alert-warning">
					<span>{ i18n.T(ctx, "No configs available. Assign chains to this user first.") }</span>
				</div>
			} else {
				<div class="flex flex-col gap-3">
					for _, cfg := range configs {
						<div class="tn-card">
							<div class="flex items-center justify-between mb-2">
								<div class="font-semibold text-sm">{ cfg.ChainName }</div>
								<span class="pill">{ cfg.Protocol }</span>
							</div>
							<div class="text-xs mb-2" style="color: var(--mut)">{ cfg.Description }</div>
							<div class="relative">
								<textarea
									rows="2"
									readonly
									class="ta w-full text-xs font-mono resize-none">{ cfg.ConfigLink }</textarea>
								<button
									class="btn btn-xs btn-ghost absolute top-1 right-1"
									onclick="var ta=this.parentElement.querySelector('textarea'); ta.select(); navigator.clipboard.writeText(ta.value);">
									{ i18n.T(ctx, "Copy") }
								</button>
							</div>
							if cfg.Protocol == "awg" {
								<div class="flex gap-1 mt-2">
									<span class="text-xs" style="color: var(--mut2)">{ i18n.T(ctx, "AWG version") }:</span>
									<button type="button" class="btn btn-xs btn-ghost" hx-get={ "/ui/users/" + u.ID + "/config?awg_version=1.5" } hx-target="#modal-container" hx-swap="innerHTML">1.5</button>
									<button type="button" class="btn btn-xs btn-ghost" hx-get={ "/ui/users/" + u.ID + "/config?awg_version=2" } hx-target="#modal-container" hx-swap="innerHTML">2.0</button>
									<button type="button" class="btn btn-xs btn-ghost" hx-get={ "/ui/users/" + u.ID + "/config?awg_version=3" } hx-target="#modal-container" hx-swap="innerHTML">3.0</button>
									<button type="button" class="btn btn-xs btn-ghost" hx-get={ "/ui/users/" + u.ID + "/config?awg_version=3.1" } hx-target="#modal-container" hx-swap="innerHTML">3.1</button>
								</div>
							}
							<div class="flex justify-end mt-2">
								<button
									type="button"
									class="btn btn-xs btn-outline"
									onclick="downloadUserConfig(this)"
									data-filename={ fmt.Sprintf("%s-%s.conf", u.Name, cfg.ChainName) }>
									{ i18n.T(ctx, "Download") }
								</button>
							</div>
						</div>
					}
				</div>
			}

			<div class="flex justify-end mt-4">
				<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Close") }</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// ─── User QR View ──────────────────────────────────────────────────────────────

templ UserQRView(u *model.User, links []string) {
	<dialog id="qr-modal" class="modal" open>
		<div class="modal-box max-w-2xl">
			<h3 class="text-lg font-semibold mb-1">{ i18n.T(ctx, "QR Codes for ") }{ u.Name }</h3>
			<div class="text-xs font-mono mb-4" style="color: var(--mut2)">{ u.ID }</div>

			if len(links) == 0 {
				<div class="alert alert-warning">
					<span>{ i18n.T(ctx, "No connection links available.") }</span>
				</div>
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					for _, link := range links {
						if !strings.HasPrefix(link, "#") {
							<div class="tn-card text-center">
								<div class="text-xs font-mono mb-2 truncate" title={ link }>
									{ ellipsis(link, 50) }
								</div>
								<!-- QR code placeholder: use external API or JS for real QR -->
								<div class="bg-white p-2 inline-block rounded">
									<img
										src={ templ.URL("/ui/qr-image?data=" + url.QueryEscape(link)) }
										alt={ i18n.T(ctx, "QR Code") }
										width="150"
										height="150"
										{ templ.Attributes{"onerror": fmt.Sprintf("this.src='data:image/svg+xml,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"150\" height=\"150\"><rect width=\"150\" height=\"150\" fill=\"#ddd\"/><text x=\"50%%\" y=\"50%%\" text-anchor=\"middle\" dy=\".3em\" font-size=\"12\" fill=\"#999\">%s</text></svg>'", i18n.T(ctx, "QR unavailable"))}... }
									/>
								</div>
								<div class="text-xs mt-1">
									<a href={ link } target="_blank" class="link link-primary">{ i18n.T(ctx, "Open Link") }</a>
								</div>
							</div>
						}
					}
				</div>
			}

			<div class="flex justify-end mt-4">
				<button type="button" class="btn" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Close") }</button>
			</div>
		</div>
		<form method="dialog" class="modal-backdrop">
			<button>{ i18n.T(ctx, "Close") }</button>
		</form>
	</dialog>
}

// ─── Helpers ────────────────────────────────────────────────────────────────────

func containsProtocol(slice []string, item string) bool {
	for _, s := range slice {
		if s == item {
			return true
		}
	}
	return false
}

func safeJS(s string) string {
	// Escape single quotes for JS embed
	return strings.ReplaceAll(s, "'", "\\'")
}

func ellipsis(s string, maxLen int) string {
	if len(s) <= maxLen {
		return s
	}
	return s[:maxLen] + "..."
}

// fmtBytes renders a byte count compactly for the traffic column (KiB/MiB/GiB).
func fmtBytes(n int64) string {
	const unit = 1024
	if n < unit {
		return fmt.Sprintf("%d B", n)
	}
	div, exp := int64(unit), 0
	for x := n / unit; x >= unit; x /= unit {
		div *= unit
		exp++
	}
	return fmt.Sprintf("%.1f %ciB", float64(n)/float64(div), "KMGTPE"[exp])
}

func fmtDuration(d time.Duration) string {
	if d < time.Minute {
		return fmt.Sprintf("%ds", int(d.Seconds()))
	}
	if d < time.Hour {
		return fmt.Sprintf("%dm", int(d.Minutes()))
	}
	days := int(d.Hours()) / 24
	hours := int(d.Hours()) % 24
	if days > 0 {
		return fmt.Sprintf("%dd%dh", days, hours)
	}
	return fmt.Sprintf("%dh", hours)
}

// displayShow returns "block" when show is true, "none" otherwise — a helper
// for templ.KV("display", ...) style toggles (templ expressions do not accept
// Go's ?: ternary, so this centralizes the conditional).
func displayShow(show bool) string {
	if show {
		return "block"
	}
	return "none"
}

// userStatusBadge returns the i18n status label + the .st pill modifier class
// for a user. Prefers the persisted u.Status (set by handlers via ComputeStatus);
// falls back to deriving on the fly so the list renders correctly even for
// users loaded before the Status field existed (legacy/empty).
func userStatusBadge(u *model.User) (label, class string) {
	status := u.Status
	if status == "" {
		status = u.ComputeStatus()
	}
	switch status {
	case "active":
		return "Active", "st-ok"
	case "disabled":
		return "Inactive", "st-mut"
	case "expired":
		return "Expired", "st-err"
	case "on_hold":
		return "On hold", "st-warn"
	case "limited":
		return "Limited", "st-warn"
	default:
		return "Inactive", "st-mut"
	}
}

// onlineWindow is how recent the last AWG traffic observation must be for the
// online badge. Matches the fleet bot's /online heuristic.
const onlineWindow = 6 * time.Minute

// userOnline reports whether the user's last AWG traffic observation is fresh
// enough to count as online (granularity is bounded by the metrics interval).
func userOnline(u *model.User) bool {
	return u.Active && !u.AWGTrafficAt.IsZero() && time.Since(u.AWGTrafficAt) <= onlineWindow
}

// ─── Bulk user creation (seller workflow) ────────────────────────────────────

// BulkUserForm is the "create N users from a template" modal.
templ BulkUserForm(chains []*model.Chain) {
	<dialog id="bulk-users-modal" class="modal" open>
		<div class="modal-box" style="max-width: 42rem;">
			<h3 class="text-lg font-semibold mb-3">{ i18n.T(ctx, "Bulk Add Users") }</h3>
			<form hx-post="/ui/users/bulk" hx-target="#modal-container" hx-swap="innerHTML" class="grid gap-3 md:grid-cols-2">
				<div>
					<label class="lbl">{ i18n.T(ctx, "Count") }</label>
					<input type="number" name="count" class="inp" value="10" min="1" max="100" required/>
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Name prefix") }</label>
					<input type="text" name="name_prefix" class="inp" value="client" required/>
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Expires in (days)") }</label>
					<input type="number" name="expires_days" class="inp" value="30" min="0" max="3650"/>
					<p class="hint">{ i18n.T(ctx, "0 = no expiry") }</p>
				</div>
				<div>
					<label class="lbl">{ i18n.T(ctx, "Data limit (GB)") }</label>
					<input type="number" name="data_limit_gb" class="inp" value="0" min="0"/>
					<p class="hint">{ i18n.T(ctx, "0 = unlimited") }</p>
				</div>
				<div class="md:col-span-2">
					<span class="lbl">{ i18n.T(ctx, "Chains") }</span>
					<div class="flex flex-col gap-1 max-h-40 overflow-y-auto p-3" style="border: 1px solid var(--bd); border-radius: 8px;">
						for _, c := range chains {
							<label class="flex items-center gap-2 cursor-pointer">
								<input type="checkbox" name="chain_names" value={ c.Name } class="cb"/>
								<span class="text-sm font-mono">{ c.Name }</span>
							</label>
						}
						if len(chains) == 0 {
							<span class="hint">{ i18n.T(ctx, "No chains yet") }</span>
						}
					</div>
				</div>
				<div class="md:col-span-2 flex justify-end gap-2">
					<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Cancel") }</button>
					<button type="submit" class="btn btn-primary">{ i18n.T(ctx, "Create") }</button>
				</div>
			</form>
		</div>
		<form method="dialog" class="modal-backdrop"><button>Close</button></form>
	</dialog>
}

// BulkUserResult reports the outcome of a bulk create; HTMX swaps it into the
// modal container, then a page refresh shows the new rows.
templ BulkUserResult(created int, prefix string, errMsg string) {
	<dialog id="bulk-users-modal" class="modal" open>
		<div class="modal-box" style="max-width: 36rem;">
			if errMsg != "" {
				<div class="alert alert-error text-sm">{ errMsg }</div>
			} else {
				<div class="alert alert-success text-sm">
					{ fmt.Sprintf(i18n.T(ctx, "%d users created (prefix %q) — refresh to see them"), created, prefix) }
				</div>
			}
			<div class="flex justify-end mt-4 gap-2">
				<button type="button" class="btn btn-ghost" onclick="this.closest('dialog').close()">{ i18n.T(ctx, "Close") }</button>
				if errMsg == "" {
					<button type="button" class="btn btn-primary" onclick="location.href='/ui/users'">{ i18n.T(ctx, "Refresh") }</button>
				}
			</div>
		</div>
		<form method="dialog" class="modal-backdrop"><button>Close</button></form>
	</dialog>
}

// ─── User Created Result (post-create sub URL box) ─────────────────────────────

// UserCreatedResult is the HTMX response to a successful user create: a row
// replacement showing the user's new Subscription URL with Copy/QR buttons
// (reuses the copy-onclick pattern + /ui/qr-image route). Rendered instead of
// UserRow on create so the operator immediately gets the shareable URL.
// subURL is the full https://host/sub/{token} string built by the handler.
templ UserCreatedResult(u *model.User, subURL string) {
	<tr id={ "user-" + u.ID }>
		<td colspan="7" style="background: color-mix(in oklab, var(--su) 10%, var(--b2))">
			<div class="p-3 flex flex-col gap-2">
				<div class="font-medium">{ u.Name }</div>
				<div class="text-xs" style="color: var(--mut)">{ i18n.T(ctx, "Subscription URL") }</div>
				<div class="join w-full">
					<input type="text" class="inp join-item font-mono w-full" value={ subURL } readonly id={ "sub-" + u.ID } />
					<button type="button" class="btn btn-outline btn-sm join-item" onclick="copySubURL(this)" data-target={ "sub-" + u.ID } data-copied={ i18n.T(ctx, "Copied") }>{ i18n.T(ctx, "Copy") }</button>
					<button type="button" class="btn btn-outline btn-sm join-item" hx-get={ "/ui/qr-image?data=" + url.QueryEscape(subURL) } hx-target="#qr-modal-container">{ i18n.T(ctx, "QR") }</button>
				</div>
				<div class="text-xs" style="color: var(--mut2)">{ i18n.T(ctx, "Paste this into your client (v2rayNG/Nekoray/sing-box).") }</div>
			</div>
		</td>
	</tr>
}
