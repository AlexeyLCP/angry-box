package templates

import (
	"fmt"
	"math"
	"strings"

	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// SpiderWeb renders the visual chain editor (SVG-based spider web) with
// graph edges (ConnectionLink), persistent node positions, and native SVG
// pan/zoom. Links are the source of truth for topology; Chain.Nodes is the
// materialized deploy path kept in sync by the handlers.
templ SpiderWeb(hosts []*model.Host, chains []*model.Chain, infos []*model.NodeInfo, links []*model.ConnectionLink, metrics []*model.NodeMetrics) {
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<h2 class="text-2xl font-semibold">{ i18n.T(ctx, "Spider Web") }</h2>
			<div class="flex gap-2">
				<button
					class="btn btn-ghost btn-sm"
					hx-get="/ui/spider"
					hx-target="#main-content"
					hx-swap="outerHTML">
					{ i18n.T(ctx, "Refresh") }
				</button>
			</div>
		</div>

		<!-- SVG Canvas with pan/zoom -->
		<div class="tn-card overflow-hidden">
			<div class="p-4 border-b border-base-300 flex items-center justify-between">
				<div class="text-sm text-base-content/60">{ i18n.T(ctx, "Drag nodes to rearrange (positions are saved). Scroll to zoom, drag background to pan. Green = online.") }</div>
				<div class="flex gap-1">
					<button class="btn btn-xs btn-ghost" onclick="spiderZoom(1.2)">+</button>
					<button class="btn btn-xs btn-ghost" onclick="spiderZoom(1/1.2)">−</button>
					<button class="btn btn-xs btn-ghost" onclick="spiderReset()">{ i18n.T(ctx, "reset") }</button>
				</div>
			</div>
			<div class="bg-base-200 relative" style="min-height: 550px;">
				if len(hosts) == 0 {
					<div class="flex items-center justify-center h-64 text-base-content/50">
						{ i18n.T(ctx, "No nodes registered.") } <a hx-get="/ui/nodes" hx-target="#main-content" hx-push-url="true" class="link link-primary ml-1">{ i18n.T(ctx, "Add nodes first") }</a>.
					</div>
				} else {
					<svg id="spider-svg" viewBox="0 0 1600 900" class="w-full" style="min-height: 550px; cursor: grab; touch-action: none;">
						<defs>
							<marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
								<polygon points="0 0, 10 3.5, 0 7" fill="oklch(var(--p))" />
							</marker>
						</defs>
						<g id="spider-viewport" transform="translate(0,0) scale(1)">
							<!-- Pan catcher: transparent rect covering the viewport -->
							<rect x="0" y="0" width="1600" height="900" fill="transparent" id="spider-pan-catcher" style="cursor: grab;"/>

							<!-- Graph edges from ConnectionLink (source of truth) -->
							for _, link := range spiderGraphLinks(links, hosts, infos, chains) {
								<line
									x1={ fmt.Sprintf("%.0f", link.X1) }
									y1={ fmt.Sprintf("%.0f", link.Y1) }
									x2={ fmt.Sprintf("%.0f", link.X2) }
									y2={ fmt.Sprintf("%.0f", link.Y2) }
									data-from={ link.FromID }
									data-to={ link.ToID }
									data-link-id={ link.ID }
									stroke="oklch(var(--p) / 0.45)"
									stroke-width="2"
									stroke-dasharray="6,3"
									marker-end="url(#arrowhead)"
								/>
								<text
									x={ fmt.Sprintf("%.0f", (link.X1+link.X2)/2) }
									y={ fmt.Sprintf("%.0f", (link.Y1+link.Y2)/2 - 8) }
									text-anchor="middle"
									class="text-[10px]"
									fill="oklch(var(--bc) / 0.5)">
									{ string(link.Transport) }
								</text>
							}

							<!-- Nodes -->
							for _, sn := range spiderNodes(hosts, infos, chains, metrics) {
								@spiderNode(sn.ID, sn.Country, chains, sn.X, sn.Y, sn.State)
							}
						</g>
					</svg>
					<script src="/static/js/spider.js"></script>
					<script>
						initSpiderInteraction();
					</script>
				}
			</div>
		</div>

		<!-- Add connection form -->
		<div class="tn-card">
			<div class="card-body p-3">
				<h3 class="font-semibold mb-2">{ i18n.T(ctx, "Create New Connection") }</h3>
				<form
					hx-post="/ui/spider/links"
					hx-target="#main-content"
					hx-swap="outerHTML"
					class="space-y-2">

					<div class="grid grid-cols-1 md:grid-cols-5 gap-3">
						<div class="form-control">
							<label class="label py-1"><span class="label-text text-xs">{ i18n.T(ctx, "From Node") }</span></label>
							<select name="from_node" class="select select-bordered select-sm" required>
								<option value="">{ i18n.T(ctx, "Select...") }</option>
								for _, h := range hosts {
									<option value={ h.ID }>{ h.ID } ({ h.Addr })</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label py-1"><span class="label-text text-xs">{ i18n.T(ctx, "To Node") }</span></label>
							<select name="to_node" class="select select-bordered select-sm" required>
								<option value="">{ i18n.T(ctx, "Select...") }</option>
								for _, h := range hosts {
									<option value={ h.ID }>{ h.ID } ({ h.Addr })</option>
								}
							</select>
						</div>
						<div class="form-control">
							<label class="label py-1"><span class="label-text text-xs">{ i18n.T(ctx, "Transport") }</span></label>
							<select name="transport" class="select select-bordered select-sm">
								<option value="xhttp" selected>{ i18n.T(ctx, "XHTTP (max obfuscation, recommended)") }</option>
								<option value="reality">{ i18n.T(ctx, "Reality + XHTTP (max obfuscation)") }</option>
								<option value="awg">{ i18n.T(ctx, "AWG / AmneziaWG (encrypted tunnel)") }</option>
							</select>
						</div>
						<div class="form-control">
							<label class="label py-1"><span class="label-text text-xs">{ i18n.T(ctx, "Chain Name") }</span></label>
							<input type="text" name="chain_name" class="input input-bordered input-sm" required placeholder="my-chain" />
						</div>
						<div class="form-control justify-end pt-5">
							<button type="submit" class="btn btn-primary btn-sm">{ i18n.T(ctx, "Create Link") }</button>
						</div>
					</div>
				</form>
			</div>
		</div>

		<!-- Existing edges -->
		if len(links) > 0 {
			<div class="tn-card">
				<div class="card-body p-3">
					<h3 class="font-semibold mb-2">{ i18n.T(ctx, "Connections") }</h3>
					<div class="space-y-1">
						for _, l := range links {
							<div class="flex items-center justify-between border border-base-300 rounded-lg p-2 text-sm">
								<div>
									<span class="font-mono">{ l.FromNodeID }</span>
									<span class="text-base-content/50 mx-1">→</span>
									<span class="font-mono">{ l.ToNodeID }</span>
									<span class="text-base-content/50 ml-2">| { l.Transport } | { l.ChainName }</span>
								</div>
								if strings.HasPrefix(l.ID, "synth:") {
									<span class="badge badge-xs badge-outline" title={ i18n.T(ctx, "Derived from chain levels — edit in the chain form") }>{ i18n.T(ctx, "levels") }</span>
								} else {
									<button
										class="btn btn-ghost btn-xs text-error"
										hx-delete={ "/ui/spider/links/" + l.ID }
										hx-confirm={ i18n.T(ctx, "Delete connection ") + l.FromNodeID + "→" + l.ToNodeID + "?" }
										hx-target="#main-content"
										hx-swap="outerHTML">
										{ i18n.T(ctx, "Delete") }
									</button>
								}
							</div>
						}
					</div>
				</div>
			</div>
		}

		<!-- Existing Chains (apply/delete shortcuts) -->
		if len(chains) > 0 {
			<div class="tn-card">
				<div class="card-body p-3">
					<h3 class="font-semibold mb-2">{ i18n.T(ctx, "Chains") }</h3>
					<div class="space-y-2">
						for _, c := range chains {
							<div class="flex items-center justify-between border border-base-300 rounded-lg p-3">
								<div>
									<div class="font-semibold">{ c.Name }</div>
									<div class="text-xs text-base-content/50">
										{ chainNodeList(c.Nodes) }
										<span class="ml-2">| { c.Transport } | { c.Strategy }</span>
									</div>
								</div>
								<div class="flex gap-2">
									<button
										class="btn btn-primary btn-xs"
										hx-post={"/ui/chains/" + c.Name + "/apply"}
										hx-target="#spider-apply-result"
										hx-swap="innerHTML">
										{ i18n.T(ctx, "Apply") }
									</button>
									<button
										class="btn btn-ghost btn-xs text-error"
										hx-delete={"/ui/chains/" + c.Name}
										hx-confirm={i18n.T(ctx, "Delete chain ") + c.Name + "?"}
										hx-target="closest .border"
										hx-swap="outerHTML">
										{ i18n.T(ctx, "Delete") }
									</button>
								</div>
							</div>
						}
					</div>
					<div id="spider-apply-result" class="mt-2"></div>
				</div>
			</div>
		}
	</div>
}

// chainNodeList returns a text representation of node IDs with arrows
func chainNodeList(nodes []model.ChainNode) string {
	s := ""
	for i, n := range nodes {
		if i > 0 {
			s += " → "
		}
		s += n.ID
	}
	return s
}

// spiderNode renders a single node circle on the SVG canvas
templ spiderNode(id string, country string, chains []*model.Chain, x, y float64, state string) {
	<g class="spider-node cursor-pointer" data-node-id={ id }>
		<circle class="node-inner"
			cx={ fmt.Sprintf("%.0f", x) }
			cy={ fmt.Sprintf("%.0f", y) }
			r="16"
			fill="oklch(var(--b1))"
			stroke="oklch(var(--p) / 0.2)"
			stroke-width="2"
		/>
		<circle
			cx={ fmt.Sprintf("%.0f", x) }
			cy={ fmt.Sprintf("%.0f", y) }
			r="12"
			fill="oklch(var(--p) / 0.15)"
		/>
		<circle class="status-dot"
			cx={ fmt.Sprintf("%.0f", x + 10) }
			cy={ fmt.Sprintf("%.0f", y - 10) }
			r="3"
			fill={ statusDotFill(state) }
		/>
		if country != "" {
			<text class="country-label"
				x={ fmt.Sprintf("%.0f", x) }
				y={ fmt.Sprintf("%.0f", y - 18) }
				text-anchor="middle"
				class="text-xs"
				fill="oklch(var(--bc))">{ country }</text>
		}
		<text class="node-id-label"
			x={ fmt.Sprintf("%.0f", x) }
			y={ fmt.Sprintf("%.0f", y + 4) }
			text-anchor="middle"
			class="text-[11px] font-mono font-semibold"
			fill="oklch(var(--bc))">{ id }</text>
		if spiderChainCount(id, chains) > 0 {
			<text class="chain-count-label"
				x={ fmt.Sprintf("%.0f", x) }
				y={ fmt.Sprintf("%.0f", y + 14) }
				text-anchor="middle"
				class="text-[9px]"
				fill="oklch(var(--bc) / 0.5)">{ fmt.Sprintf(i18n.T(ctx, "%d chain(s)"), spiderChainCount(id, chains)) }</text>
		}
	</g>
}

// nodePosition computes a circular layout position for a node WITHOUT a saved
// position. Saved positions (NodeInfo.PosX/PosY) take precedence in spiderNodes.
func nodePosition(idx int, total int) (float64, float64) {
	if total == 0 {
		return 800, 450
	}
	angle := float64(idx)*2.0*math.Pi/float64(total) - math.Pi/2.0
	r := 250.0
	if total <= 3 {
		r = 180.0
	}
	x := 800.0 + r*math.Cos(angle)
	y := 450.0 + r*math.Sin(angle)
	return x, y
}

func findInfoSpider(id string, infos []*model.NodeInfo) *model.NodeInfo {
	for _, ni := range infos {
		if ni != nil && ni.ID == id {
			return ni
		}
	}
	return nil
}

// statusDotFill returns the oklch color var for the spider status dot, keyed
// by node health state. Mirrors the dashboard badge colors so the spider and
// the dashboard agree on the visual language. Was hardcoded green (oklch(var
// --su)) before P1a — now data-driven from nodeState.
func statusDotFill(state string) string {
	switch state {
	case model.NodeStateHealthy:
		return "oklch(var(--su))"
	case model.NodeStateSuspect:
		return "oklch(var(--wa))"
	case model.NodeStateDown, model.NodeStateUnreachable, model.NodeStateBlocked:
		return "oklch(var(--er))"
	default:
		return "oklch(var(--bc) / 0.4)"
	}
}

type spiderLinkData struct {
	ID                  string
	X1, Y1, X2, Y2      float64
	Transport           model.TransportType
	FromID, ToID        string
}

type spiderNodeData struct {
	ID      string
	Country string
	State   string
	X, Y    float64
}

// spiderGraphLinks builds the edge list for rendering from ConnectionLink (the
// topology source of truth). Endpoints are resolved from saved node positions
// (NodeInfo.PosX/PosY) with the circular layout as a fallback.
func spiderGraphLinks(links []*model.ConnectionLink, hosts []*model.Host, infos []*model.NodeInfo, chains []*model.Chain) []spiderLinkData {
	var out []spiderLinkData
	for _, l := range links {
		x1, y1 := nodePosFor(l.FromNodeID, hosts, infos)
		x2, y2 := nodePosFor(l.ToNodeID, hosts, infos)
		out = append(out, spiderLinkData{
			ID: l.ID, X1: x1, Y1: y1, X2: x2, Y2: y2,
			Transport: l.Transport, FromID: l.FromNodeID, ToID: l.ToNodeID,
		})
	}
	_ = chains
	return out
}

// nodePosFor returns the (x, y) for a node ID: the saved position if set,
// otherwise the circular-layout fallback keyed by host index.
func nodePosFor(id string, hosts []*model.Host, infos []*model.NodeInfo) (float64, float64) {
	if ni := findInfoSpider(id, infos); ni != nil && (ni.PosX != 0 || ni.PosY != 0) {
		return ni.PosX, ni.PosY
	}
	return nodePosition(idxOf(id, hosts), len(hosts))
}

func spiderNodes(hosts []*model.Host, infos []*model.NodeInfo, chains []*model.Chain, metrics []*model.NodeMetrics) []spiderNodeData {
	var nodes []spiderNodeData
	for i, h := range hosts {
		x, y := nodePosFor(h.ID, hosts, infos)
		if x == 0 && y == 0 {
			x, y = nodePosition(i, len(hosts))
		}
		country := ""
		if ni := findInfoSpider(h.ID, infos); ni != nil {
			country = ni.Country
		}
		// Derive the node's health state from its latest metrics so the spider
		// status dot reflects reality (was hardcoded green before P1a).
		state := model.NodeStateUnknown
		for _, m := range metrics {
			if m.HostID == h.ID {
				state = NodeState(m)
				break
			}
		}
		nodes = append(nodes, spiderNodeData{ID: h.ID, Country: country, State: state, X: x, Y: y})
	}
	_ = chains
	return nodes
}

func spiderChainCount(id string, chains []*model.Chain) int {
	count := 0
	for _, c := range chains {
		for _, n := range c.Nodes {
			if n.ID == id {
				count++
				break
			}
		}
	}
	return count
}

func idxOf(id string, hosts []*model.Host) int {
	for i, h := range hosts {
		if h.ID == id {
			return i
		}
	}
	return 0
}