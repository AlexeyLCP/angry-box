package templates

import (
	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// HostStatus shows the result of a GetStatus call for a host.
templ HostStatus(status *model.Status) {
	<div class="flex flex-col gap-0.5 text-xs">
		if status.Running {
			<span class="badge badge-success badge-sm">{ i18n.T(ctx, "Running") }</span>
			<span class="font-mono text-[10px] opacity-70">{ status.Version }</span>
		} else {
			<span class="badge badge-error badge-sm">{ i18n.T(ctx, "Stopped") }</span>
		}
		if status.Error != "" {
			<span class="text-error text-[10px] truncate max-w-[120px]" title={status.Error}>
				{ status.Error }
			</span>
		}
	</div>
}
