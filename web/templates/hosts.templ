package templates

import (
	"github.com/alexeylcp/angry-box/internal/domain/model"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

// HostStatus shows the result of a GetStatus call for a host.
templ HostStatus(status *model.Status) {
	<div class="flex flex-col gap-0.5 text-xs">
		if status.Running {
			<span class="st st-ok"><span class="dot"></span>{ i18n.T(ctx, "Running") }</span>
			<span class="font-mono text-[10px]" style="color: var(--mut2)">{ status.Version }</span>
		} else {
			<span class="st st-err"><span class="dot"></span>{ i18n.T(ctx, "Stopped") }</span>
		}
		if status.Error != "" {
			<span class="text-[10px] truncate max-w-[120px]" style="color: var(--er)" title={status.Error}>
				{ status.Error }
			</span>
		}
	</div>
}
