package templates

import (
	"github.com/alexeylcp/angry-box/internal/chain"
	"github.com/alexeylcp/angry-box/internal/i18n"
)

templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang={ i18n.Lang(ctx) } data-theme="tokyonight">
	<head>
		<script>
			// Pre-paint theme application (prevents FOUC). Migrate old dark/light
			// localStorage values to the Tokyo Night theme names.
			(function(){
				var t = localStorage.getItem('angrybox-theme') || 'tokyonight';
				if (t === 'dark') t = 'tokyonight';
				else if (t === 'light') t = 'tokyonight-day';
				var valid = ['tokyonight','tokyonight-day','tokyonight-storm'];
				if (valid.indexOf(t) < 0) t = 'tokyonight';
				document.documentElement.setAttribute('data-theme', t);
			})();
		</script>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="theme-color" content="#16161e">
		<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg" />
		<title>{ title } | Angry-BOX</title>

		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<link href="/static/css/fonts.css" rel="stylesheet" />
		<link href="https://cdn.jsdelivr.net/npm/daisyui@4/dist/full.min.css" rel="stylesheet" type="text/css" />
		<script src="https://cdn.tailwindcss.com"></script>
		<script src="https://unpkg.com/htmx.org@1.9.12"></script>

		<style>
			html, body { overflow-x: hidden; max-width: 100vw; }
			body { font-family: 'IBM Plex Sans', 'Inter', sans-serif; font-size: 14px; line-height: 1.5; }
			.font-mono, code, pre, kbd { font-family: 'IBM Plex Mono', 'SF Mono', ui-monospace, monospace; }
			* { box-sizing: border-box; }
			.sidebar-active { @apply bg-primary/20 text-primary border-r-2 border-primary; }
			.status-online { @apply bg-success; }
			.status-offline { @apply bg-error; }
			.status-degraded { @apply bg-warning; }
		</style>
		<link href="/static/css/tokyo-night.css" rel="stylesheet" />
		<link href="/static/css/app.css" rel="stylesheet" />
	</head>
	<body class="min-h-screen bg-gradient-to-br from-base-300 to-base-100 text-base-content antialiased">
		<div id="htmx-loading-bar"></div>
		<div class="flex h-screen overflow-hidden">
			<div class="w-64 bg-base-200/50 backdrop-blur-md border-r border-base-content/10 flex flex-col shadow-xl z-20">
				<a href="/ui" class="block p-6 border-b border-base-content/10 hover:bg-base-content/5 transition-colors cursor-pointer">
					<div class="flex items-center gap-2">
						<div class="w-8 h-8 bg-primary rounded-lg flex items-center justify-center">
							<span class="text-primary-content font-bold text-lg">A</span>
						</div>
						<div>
							<div class="font-semibold text-lg">Angry-BOX</div>
							<div class="text-xs text-base-content/60 -mt-1">{ i18n.T(ctx, "Orchestrator") }</div>
						</div>
					</div>
				</a>

				<div class="flex-1 p-2">
					<ul class="menu w-full">
						<li><a hx-get="/ui" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" /></svg><span>{ i18n.T(ctx, "Dashboard") }</span></a></li>
						<li><a hx-get="/ui/nodes" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg><span>{ i18n.T(ctx, "Nodes") }</span></a></li>
						<li><a hx-get="/ui/inbounds" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg><span>{ i18n.T(ctx, "Inbounds") }</span></a></li>
						<li><a hx-get="/ui/spider" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg><span>{ i18n.T(ctx, "Spider Web") }</span></a></li>
						<li><a hx-get="/ui/chains" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg><span>{ i18n.T(ctx, "Chains") }</span></a></li>
						<li><a hx-get="/ui/clients" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4z" /></svg><span>{ i18n.T(ctx, "Clients") }</span></a></li>
						<li><a hx-get="/ui/presets" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2H5a2 2 0 00-2 2v2" /></svg><span>{ i18n.T(ctx, "Presets") }</span></a></li>
						<li><a hx-get="/ui/deploy-status" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg><span>{ i18n.T(ctx, "Deploy Status") }</span></a></li>
						<li><a hx-get="/ui/audit" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg><span>{ i18n.T(ctx, "Audit") }</span></a></li>
						<li><a hx-get="/ui/status" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg><span>{ i18n.T(ctx, "Status") }</span></a></li>
					</ul>
				</div>
				<div class="p-2 border-t border-base-300">
					<ul class="menu w-full">
						<li><a hx-get="/ui/settings" hx-target="#main-content" hx-push-url="true" class="flex items-center gap-2">							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
							<span>{ i18n.T(ctx, "Settings") }</span></a></li>
					</ul>
				</div>

				<div class="p-4 border-t border-base-content/10 text-xs text-base-content/40 text-center font-medium">
					{ i18n.T(ctx, "Angry-BOX • Orchestrator") }
				</div>
			</div>

			<div class="flex-1 flex flex-col overflow-hidden relative">
				<div class="h-16 border-b border-base-content/10 bg-base-100/40 backdrop-blur-xl px-6 flex items-center justify-between sticky top-0 z-10 shadow-sm">
					<div class="flex items-center gap-4">
						<h1 class="text-lg font-semibold" id="page-title">{ title }</h1>
					</div>
					<div class="flex items-center gap-4">
							<span class="text-[10px] text-base-content/20">PolyForm Noncommercial 1.0.0 &middot; { i18n.T(ctx, "Personal/Educational use only") }</span>
							<div class="text-sm text-base-content/60 flex items-center gap-2">
								<span>{ i18n.T(ctx, "Profile:") } <span class="font-mono text-primary">{ chain.GetDefaultPresetName() }</span></span>
								<span id="connection-status" class="opacity-50">| { i18n.T(ctx, "Connected") }</span>
								<div class="dropdown dropdown-end">
									<div tabindex="0" role="button" class="btn btn-ghost btn-circle btn-sm" aria-label={ i18n.T(ctx, "Theme") } title={ i18n.T(ctx, "Theme") }>
										<svg id="ico-sun" class="w-4 h-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
										<svg id="ico-moon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
									</div>
									<ul tabindex="0" class="dropdown-content z-[1000] menu p-2 shadow-lg bg-base-200 rounded-box w-52 border border-base-300">
										<li class="menu-title text-xs">{ i18n.T(ctx, "Theme") }</li>
										<li><button data-set-theme="tokyonight" class="theme-option">
											<span class="theme-swatch" style="background:#1a1b26;border:1px solid #3b4261"></span>
											{ i18n.T(ctx, "Tokyo Night") }
										</button></li>
										<li><button data-set-theme="tokyonight-day" class="theme-option">
											<span class="theme-swatch" style="background:#e9e9ed;border:1px solid #b8b9c0"></span>
											{ i18n.T(ctx, "Tokyo Night Day") }
										</button></li>
										<li><button data-set-theme="tokyonight-storm" class="theme-option">
											<span class="theme-swatch" style="background:#1f2335;border:1px solid #414868"></span>
											{ i18n.T(ctx, "Tokyo Night Storm") }
										</button></li>
									</ul>
								</div>
							</div>
					</div>
				</div>

				<div id="main-content" class="flex-1 overflow-auto p-6">
					@content
				</div>
			</div>
			</div>

		<script>
			// Server-rendered JS i18n dictionary for the few client-side strings.
			window.AB_I18N = {
				lang: {{ i18n.Lang(ctx) }},
				t: function(k){ var d=this.dict[this.lang]||{}; return d[k]||k; },
				dict: {
					ru: {
						"Key name": "Имя ключа",
						"/path/to/key": "/путь/к/ключу",
						"None": "Нет",
						"Public key will be added to authorized_keys on": "Публичный ключ будет добавлен в authorized_keys на",
						"a new key will be generated and added": "новый ключ будет сгенерирован и добавлен"
					},
					en: {}
				}
			};
		</script>
		<script src="/static/js/app.js"></script>
	</body>
	</html>
}
