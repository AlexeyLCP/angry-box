# Fix: chacha20poly1305 "invalid buffer overlap of output and input" panic
# with AmneziaWG obfuscation in userspace (gVisor) mode.
#
# File: device/send.go — RoutineEncryption
# wireguard-go v0.0.2-beta.1-extended-1.4.3 (shtorm-7/wireguard-go)
#
# Root cause: Seal(header, nonce, elem.packet, nil) writes ciphertext by
# appending to `header` (a slice of elem.buffer), while the plaintext
# `elem.packet` is a later slice of the SAME elem.buffer — output overlaps
# input, which golang.org/x/crypto/chacha20poly1305 rejects with a panic.
# Plain WireGuard tolerates the in-place seal (contiguous header+packet), but
# AmneziaWG's junk packets / padding break that invariant → panic on the first
# encrypted packet (not at startup).
#
# Fix: Seal into a fresh buffer (dst = nil → no overlap), then copy the
# ciphertext back into elem.buffer after the already-written transport header.
#
# Apply: patch -p1 < wireguard-go-awg-overlap.patch  (in wireguard-go repo root)
#        then point sing-box-extended at the patched tree via go.mod replace:
#        replace github.com/sagernet/wireguard-go => ../wireguard-go-patched
diff --git a/device/send.go b/device/send.go
index 80fe016..c4afdc4 100644
--- a/device/send.go
+++ b/device/send.go
@@ -556,15 +556,18 @@ func (device *Device) RoutineEncryption(id int) {
 			// encrypt content and release to consumer
 
 			binary.LittleEndian.PutUint64(nonce[4:], elem.nonce)
-			elem.packet = elem.keypair.send.Seal(
-				header,
+			// AmneziaWG: seal into a fresh buffer to avoid the chacha20poly1305
+			// "invalid buffer overlap of output and input" panic. The transport
+			// header is already written into elem.buffer; copy the ciphertext
+			// right after it.
+			sealed := elem.keypair.send.Seal(
+				nil,
 				nonce[:],
 				elem.packet,
 				nil,
 			)
-
-			// re-slice packet to include encapsulating transport space
-			elem.packet = elem.buffer[:MessageEncapsulatingTransportSize+len(elem.packet)]
+			copy(elem.buffer[MessageEncapsulatingTransportSize:], sealed)
+			elem.packet = elem.buffer[:MessageEncapsulatingTransportSize+len(sealed)]
 		}
 		elemsContainer.Unlock()
 	}
